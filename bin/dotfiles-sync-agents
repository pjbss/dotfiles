#!/bin/zsh
# dotfiles-sync-agents
#
# Renders tool-neutral skills under agents/skills/<skill-name>/SKILL.md, plus
# the Claude-only extension layer under agents/claude-only/, into each
# supported tool's native format. Manual/explicit only -- nothing in this
# repo runs this automatically.
#
# Currently supported targets:
#   - Claude Code: agents/skills/*/SKILL.md -> ~/.claude/skills/<skill-name>/,
#     copied at full fidelity (frontmatter, body, and any supporting files).
#   - Claude Code: local/skills/*/SKILL.md (gitignored, private/company
#     skills -- see local/README.md) -> ~/.claude/skills/<skill-name>/, same
#     full-fidelity treatment as agents/skills/. Scanned after agents/skills/,
#     so a local skill with the same name wins.
#   - Claude Code: agents/claude-only/subagents/*.md ->
#     ~/.claude/agents/<name>.md, copied at full fidelity.
#   - Claude Code: agents/claude-only/workflows/*.js ->
#     ~/.claude/workflows/<name>.js, copied at full fidelity.
#   - GitHub Copilot CLI: agents/skills/*/SKILL.md and local/skills/*/SKILL.md
#     -> ~/.copilot/skills/<skill-name>/ (or $COPILOT_HOME/skills if
#     COPILOT_HOME is set), per Copilot CLI's documented personal-skills
#     format (github.com/en/copilot/how-tos/copilot-cli/customize-copilot/
#     add-skills). This format is nearly identical to the neutral one --
#     `name`/`description` map directly and supporting files are copied
#     as-is -- except Copilot has no `tags` frontmatter field, so that line
#     is dropped cleanly from the rendered copy.
#
# agents/claude-only/ has no Copilot equivalent -- the Copilot adapter skips
# it entirely rather than attempt a lossy translation.

SOURCE="${(%):-%x}"
while [ -h "$SOURCE" ]; do SOURCE="$(readlink "$SOURCE")"; done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
DOTFILES_HOME="$(cd -P "$BIN_DIR/.." && pwd)"

SKILLS_SRC_DIR="$DOTFILES_HOME/agents/skills"
LOCAL_SKILLS_SRC_DIR="$DOTFILES_HOME/local/skills"
CLAUDE_SKILLS_DST_DIR="$HOME/.claude/skills"
COPILOT_SKILLS_DST_DIR="${COPILOT_HOME:-$HOME/.copilot}/skills"

SUBAGENTS_SRC_DIR="$DOTFILES_HOME/agents/claude-only/subagents"
CLAUDE_AGENTS_DST_DIR="$HOME/.claude/agents"

WORKFLOWS_SRC_DIR="$DOTFILES_HOME/agents/claude-only/workflows"
CLAUDE_WORKFLOWS_DST_DIR="$HOME/.claude/workflows"

sync_claude_skill() {
	skill_dir="$1"
	skill_name="$(basename "$skill_dir")"
	dst="$CLAUDE_SKILLS_DST_DIR/$skill_name"

	mkdir -p "$CLAUDE_SKILLS_DST_DIR"
	rm -rf "$dst"
	mkdir -p "$dst"
	cp -R "$skill_dir/." "$dst/"
	echo "dotfiles-sync-agents: rendered $skill_name -> $dst"
}

sync_copilot_skill() {
	skill_dir="$1"
	skill_name="$(basename "$skill_dir")"
	dst="$COPILOT_SKILLS_DST_DIR/$skill_name"

	mkdir -p "$COPILOT_SKILLS_DST_DIR"
	rm -rf "$dst"
	mkdir -p "$dst"
	cp -R "$skill_dir/." "$dst/"
	# Copilot's SKILL.md frontmatter has no `tags` equivalent -- drop it
	# cleanly rather than leave an unrecognized field in the rendered copy.
	grep -v '^tags:' "$skill_dir/SKILL.md" > "$dst/SKILL.md"
	echo "dotfiles-sync-agents: rendered $skill_name -> $dst (copilot)"
}

sync_claude_only_file() {
	src_file="$1"
	dst_dir="$2"
	file_name="$(basename "$src_file")"
	dst="$dst_dir/$file_name"

	mkdir -p "$dst_dir"
	cp "$src_file" "$dst"
	echo "dotfiles-sync-agents: rendered $file_name -> $dst"
}

sync_skills_dir() {
	skills_src_dir="$1"

	if [ ! -d "$skills_src_dir" ]; then
		return
	fi

	for skill_dir in "$skills_src_dir"/*/(N); do
		[ -f "$skill_dir/SKILL.md" ] || continue
		sync_claude_skill "$skill_dir"
		sync_copilot_skill "$skill_dir"
	done
}

if [ ! -d "$SKILLS_SRC_DIR" ]; then
	echo "dotfiles-sync-agents: no skills found at $SKILLS_SRC_DIR" >&2
else
	sync_skills_dir "$SKILLS_SRC_DIR"
fi

sync_skills_dir "$LOCAL_SKILLS_SRC_DIR"

if [ -d "$SUBAGENTS_SRC_DIR" ]; then
	for subagent_file in "$SUBAGENTS_SRC_DIR"/*.md(N); do
		sync_claude_only_file "$subagent_file" "$CLAUDE_AGENTS_DST_DIR"
	done
fi

if [ -d "$WORKFLOWS_SRC_DIR" ]; then
	for workflow_file in "$WORKFLOWS_SRC_DIR"/*.js(N); do
		sync_claude_only_file "$workflow_file" "$CLAUDE_WORKFLOWS_DST_DIR"
	done
fi
