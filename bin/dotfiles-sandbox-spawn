#!/bin/sh
# dotfiles-sandbox-spawn
#
# Spawns an isolated per-task sandbox: a new git branch + worktree on the
# host, plus an ephemeral Lima VM (booted from sandbox/lima-template.yaml)
# with that worktree mounted read-write, Claude Code/GitHub CLI/AWS
# credentials mounted read-only, Docker provisioned unconditionally, and a
# VS Code Remote-SSH-ready `ssh <task-name>` entry -- plus, if the
# worktree's project defines a devcontainer.json (issue 008), the
# devcontainer CLI installed and that devcontainer built/running via
# `devcontainer up` before this returns.
#
# Usage: dotfiles-sandbox-spawn <task-name>

set -eu

SOURCE="$0"
while [ -h "$SOURCE" ]; do SOURCE="$(readlink "$SOURCE")"; done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
DOTFILES_HOME="$(cd -P "$BIN_DIR/.." && pwd)"

. "$DOTFILES_HOME/sandbox/lib/task.sh"
. "$DOTFILES_HOME/sandbox/lib/ssh_config.sh"
. "$DOTFILES_HOME/sandbox/lib/devcontainer.sh"

task_name="${1:-}"
if [ -z "$task_name" ]; then
	echo "usage: dotfiles-sandbox-spawn <task-name>" >&2
	exit 1
fi

if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
	echo "dotfiles-sandbox-spawn: must be run from inside a git repository" >&2
	exit 1
fi

repo_root="$(git rev-parse --show-toplevel)"
repo_name="$(basename "$repo_root")"

# The same slug is used as the branch name, worktree directory name, and
# Lima instance name -- one canonical identifier per task rather than three
# independently-derived ones.
instance_name="$(sandbox_instance_name "$task_name")"

if limactl list --json 2>/dev/null | grep -qF "\"name\":\"$instance_name\""; then
	echo "dotfiles-sandbox-spawn: a sandbox named '$instance_name' already exists -- pick a different task name or tear it down first" >&2
	exit 1
fi

sandbox_root="${SANDBOX_WORKTREE_ROOT:-$HOME/.sandbox-worktrees}/$repo_name"
worktree_path="$sandbox_root/worktrees/$instance_name"
vm_config="$sandbox_root/lima-configs/$instance_name.yaml"

if [ -e "$worktree_path" ]; then
	echo "dotfiles-sandbox-spawn: worktree path '$worktree_path' already exists -- pick a different task name or remove it first" >&2
	exit 1
fi

mkdir -p "$sandbox_root/worktrees" "$sandbox_root/lima-configs"

echo "dotfiles-sandbox-spawn: creating branch '$instance_name' and worktree at '$worktree_path'..."
git -C "$repo_root" worktree add -b "$instance_name" "$worktree_path"

ssh_port="$(sandbox_allocate_port)"

sandbox_render_lima_config \
	"$DOTFILES_HOME/sandbox/lima-template.yaml" \
	"$ssh_port" \
	"$worktree_path" \
	"${AWS_PROFILE:-}" > "$vm_config"

echo "dotfiles-sandbox-spawn: starting Lima VM '$instance_name' (SSH port $ssh_port)..."
limactl start --name "$instance_name" --tty=false "$vm_config"

ssh_include_file="${SANDBOX_SSH_INCLUDE_FILE:-$HOME/.ssh/dotfiles-sandbox-config}"
ssh_config_file="${SANDBOX_SSH_CONFIG_FILE:-$HOME/.ssh/config}"
lima_ssh_config="$(limactl ls --format='{{.SSHConfigFile}}' "$instance_name")"

ssh_block="$(sandbox_ssh_render_host_block "$instance_name" "$lima_ssh_config")"
sandbox_ssh_write_entry "$ssh_include_file" "$instance_name" "$ssh_block"
sandbox_ssh_ensure_include "$ssh_include_file" "$ssh_config_file"

if devcontainer_config="$(sandbox_devcontainer_config_path "$worktree_path")"; then
	echo "dotfiles-sandbox-spawn: devcontainer.json found ($devcontainer_config) -- installing the devcontainer CLI and running 'devcontainer up' inside the VM..."
	limactl shell "$instance_name" -- sh -c '
		set -eux
		if ! command -v node >/dev/null 2>&1; then
			sudo apt-get update
			sudo apt-get install -y nodejs npm
		fi
		if ! command -v devcontainer >/dev/null 2>&1; then
			sudo npm install -g @devcontainers/cli
		fi
		# sudo: the docker-group membership this VM just granted its user
		# (lima-template.yaml) only takes effect for a fresh login session --
		# this one is running over the SSH ControlMaster connection Lima
		# opened during boot, before that group change landed (confirmed
		# against a real spawn: `docker ps` failed with a permission error
		# here despite `getent group docker` already listing the user).
		# Sudo sidesteps the timing race entirely since root already owns
		# the docker socket.
		sudo devcontainer up --workspace-folder /workspace
	'
else
	echo "dotfiles-sandbox-spawn: no devcontainer.json found -- leaving VM bare"
fi

echo "dotfiles-sandbox-spawn: sandbox '$instance_name' is up (worktree: $worktree_path, ssh port: $ssh_port) -- run 'ssh $instance_name' to connect"
