#!/bin/sh
# pj-run-issues
#
# Drains the ready queue in `issues/`: for each unblocked issue, implement it
# test-first, run the suite, review it in a fresh context, and commit it only
# once that review approves. Stops on the first thing that doesn't go cleanly,
# rather than pressing on and burying the failure under later work.
#
# One commit per issue is the point of the whole arrangement -- it's what makes
# an unattended run reviewable afterwards one issue at a time, instead of
# arriving as a single undifferentiated branch.
#
# Nothing is committed before it has been reviewed. The implementing agent is
# told to leave its work in the working tree; this loop stages it, gates it on
# `make test`, has it reviewed, and makes the commit itself. Reviewing after
# the commit instead -- which is what this used to do -- meant a review could
# only ask for an amendment, so an issue that failed review twice went back
# onto the queue while its commit stayed in the branch, and the next run built
# a second commit for the same issue. There is nothing to disown if nothing was
# committed.
#
# The commit is made by pj-commit in its own process rather than by the
# implementing agent, so "exactly one commit per issue" doesn't rest on an
# agent having followed an instruction.
#
# The review runs as a separate `claude -p` process, not a subagent of the
# implementing session. A reviewer that shares context with the author has
# already been told why every decision was right, and reliably agrees. Its
# findings are printed, not just its verdict: a review whose substance lives
# only in a file nobody is watching is indistinguishable from one that never
# ran.
#
# Usage: pj-run-issues [--max-issues N] [--test-dir DIR] [--no-review]
#                      [--dry-run] [--plain] [--force] [--help|-h]
#
#   --max-issues N  Stop after N issues (default: drain the queue).
#   --test-dir DIR  Directory holding the Makefile whose `test` target gates
#                   the run (default: discovered, see below).
#   --no-review     Skip the review pass. For a first smoke test only.
#   --dry-run       Print the plan -- which issues, in what order -- and exit
#                   without invoking anything.
#   --plain         Print each agent's final message instead of its live event
#                   stream. The escape hatch, see below.
#   --force         Run outside a sandbox. See below; you almost certainly
#                   don't want this.
#
# Every line of output is labeled with the agent that produced it -- `tdd`
# while pj-tdd implements, `rev` while the reviewer reads, `fix` during a
# remediation pass, `gate` for `make test`, `git` while pj-commit writes the
# commit, `loop` for the loop's own decisions -- and colored to match. Three agents and their subagents write to
# one terminal over a run of hours; an unlabeled stream of that is not
# something anyone can audit afterwards, which defeats the point of watching an
# unattended run at all.
#
# --plain gives up the stream and goes back to printing only each agent's final
# message. It exists for one failure this repo can't control: a claude release
# whose stream-json schema the renderer doesn't understand yet would turn every
# line into an unparsed passthrough.
#
# The project is the directory this is run from, not the enclosing git
# repository's root. In a monorepo those aren't the same thing, and the repo
# root is the wrong answer: it holds neither this project's issues nor its
# tests. `issues/` has to be in that directory.
#
# The `make test` gate doesn't have to be in the same directory. Issues and the
# PRD live at the project root because that's where the paths written inside
# them resolve, while in a monorepo the Makefile belongs to one subproject
# further down. Without --test-dir, the project root is used when it has a
# `test` target, and otherwise the tree below it is searched -- finding several
# is refused rather than guessed at, since picking the wrong suite would mean
# an unattended run gated on tests that never touch the code it wrote.
#
# Refuses to run outside a spawned sandbox unless --force. This is an
# unattended agent with --dangerously-skip-permissions: the VM is what makes
# that a reasonable thing to do rather than a reckless one.
#
# Strips GH_TOKEN, GITHUB_TOKEN and every AWS_* variable from the environment
# it hands to its children, even in a VM spawned without --no-creds. An
# autonomous coding run needs to read and write the worktree; it does not need
# to be able to push to arbitrary repositories or reach a cloud account, and a
# credential that isn't in the environment can't be exfiltrated by a prompt
# injection sitting in the repo it was pointed at.
#
# Sets PJ_STOP_TESTS=1, which arms the Stop hook: a session cannot finish while
# `make test` is red, and PJ_TEST_DIR so that hook gates on the same suite this
# loop does -- the agent's own working directory is the project root, which in
# a monorepo has no Makefile, and the hook skips silently when it finds none.

set -eu

SOURCE="$0"
while [ -h "$SOURCE" ]; do SOURCE="$(readlink "$SOURCE")"; done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
DOTFILES_HOME="$(cd -P "$BIN_DIR/.." && pwd)"

. "$DOTFILES_HOME/sandbox/lib/color.sh"
. "$DOTFILES_HOME/sandbox/lib/help.sh"

# Declared in one place so a terminal that mangles them is a three-line fix
# rather than a search across the file.
GLYPH_STEP='▸'
GLYPH_OK='✓'
GLYPH_BAD='✗'
GLYPH_SUB='↳'

# Asked once, here, because the renderer runs mid-pipeline where stdout is no
# longer the terminal and `tput cols` would answer for the pipe.
term_width="$(tput cols 2>/dev/null || true)"
[ -n "$term_width" ] || term_width=100

for arg in "$@"; do
	case "$arg" in
		--help | -h)
			sandbox_script_help "$SOURCE"
			exit 0
			;;
	esac
done

# A fatal refusal keeps the program name rather than a phase label: it may
# arrive through pj-sbx-run's ssh hop, where "which command said this" is the
# first thing you need to know.
fail() {
	printf "%spj-run-issues:%s %s\n" "$C_RED" "$C_RESET" "$1" >&2
	exit 1
}

# phase_color LABEL -- the color a phase's lines are printed in.
#
# sandbox/lib/color.sh owns the palette, so that the escape sequence for
# "yellow" is decided in one place for every pj- command. The renderer keeps a
# matching table of its own, since it is a separate process and threading the
# codes through argv would be worse than restating three constants -- if one
# side's shades move, move the other's.
phase_color() {
	case "$1" in
		tdd) printf '%s' "$C_GREEN" ;;
		rev) printf '%s' "$C_MAGENTA" ;;
		fix) printf '%s' "$C_YELLOW" ;;
		gate) printf '%s' "$C_BLUE" ;;
		git) printf '%s' "$C_BOLD" ;;
		*) printf '%s' "$C_CYAN" ;;
	esac
}

# emit LABEL GLYPH MESSAGE
#
# One line in the same shape agents/lib/stream_render.py renders, for the
# loop's own events. The shapes match deliberately: the console is one stream
# with several writers, and it reads as a single coherent log only if nothing
# in it is shaped differently from everything else.
emit() {
	printf '%s %s%-4s%s %s %s\n' \
		"$(date +%H:%M:%S)" "$(phase_color "$1")" "$1" "$C_RESET" "$2" "$3"
}

say() {
	emit loop "$GLYPH_STEP" "$1"
}

# say_phase LABEL MESSAGE -- a loop decision that belongs to one agent's turn.
say_phase() {
	emit "$1" "$GLYPH_STEP" "$2"
}

say_ok() {
	emit "$1" "$GLYPH_OK" "$2"
}

say_bad() {
	emit "$1" "$GLYPH_BAD" "$2"
}

# say_sub LABEL MESSAGE -- a line subordinate to the one above it, in the same
# shape the renderer indents a subagent's work.
say_sub() {
	printf '%s %s%-4s%s   %s %s\n' \
		"$(date +%H:%M:%S)" "$(phase_color "$1")" "$1" "$C_RESET" "$GLYPH_SUB" "$2"
}

# say_verdict VERDICT_FILE WANT
#
# Puts the review's own words on the console. The loop used to read only the
# first line of this file and print "changes requested", leaving the findings --
# the entire substance of the review -- visible nowhere but a file nobody was
# watching. That made an enforced review look like a skipped one, and gave no
# way to judge whether the remediation pass that followed had addressed the
# thing that was actually wrong.
#
# WANT is `reviewed` or `findings`. On a clean verdict only the `## Reviewed`
# line is worth printing: it names the sha and whether the reviewer ran the
# suite itself rather than taking a green claim on trust, which is the one
# thing worth seeing on every issue. Findings are printed in full, because a
# run that stops for a human should already have said why.
say_verdict() {
	[ -f "$1" ] || return 0

	awk -v want="$2" '
		/^## Reviewed/ { section = "reviewed"; next }
		/^## Findings/ { section = "findings"; next }
		/^## / { section = "other"; next }
		section != want { next }
		NF == 0 { next }
		{ print }
	' "$1" | while IFS= read -r line; do
		say_sub rev "$line"
	done
}

max_issues=""
test_dir=""
review=1
dry_run=""
plain=""
force=""

while [ $# -gt 0 ]; do
	case "$1" in
		--max-issues)
			[ $# -ge 2 ] || fail "--max-issues needs a number"
			max_issues="$2"; shift 2 ;;
		--test-dir)
			[ $# -ge 2 ] || fail "--test-dir needs a directory"
			test_dir="$2"; shift 2 ;;
		--no-review) review=""; shift ;;
		--dry-run) dry_run=1; shift ;;
		--plain) plain=1; shift ;;
		--force) force=1; shift ;;
		*)
			fail "unknown argument '$1'"
			;;
	esac
done

if [ ! -f "${PJ_SANDBOX_MARKER:-/etc/pj-sandbox}" ] && [ -z "$force" ]; then
	fail "not inside a sandbox. This runs a coding agent unattended with permissions disabled -- the VM is what makes that reasonable. Spawn one with 'pj-sbx-spawn <task> --base <name> --no-creds' and run it there, or pass --force if you genuinely mean to do this on this machine."
fi

# PJ_CLAUDE_ARGS is appended after the flags below, and claude takes the last
# --output-format it is given. Overriding it there wouldn't fail -- it would
# leave the renderer with a format it can't read, and the run would go blind
# for its whole duration while still exiting 0. Refuse it instead: a run that
# won't start is recoverable in a way one that silently stopped reporting is
# not.
case "${PJ_CLAUDE_ARGS:-}" in
	*--output-format*)
		[ -n "$plain" ] || fail "PJ_CLAUDE_ARGS sets --output-format, which this loop needs for its live event stream -- a run with that overridden reports nothing for hours rather than failing. Drop it, or pass --plain to give the stream up deliberately."
		;;
esac

git rev-parse --show-toplevel >/dev/null 2>&1 || fail "must be run from inside a git repository"
project_root="$PWD"

[ -d issues ] || fail "no issues/ directory in $project_root -- this loop takes the directory you run it from as the project, not the repository root, so cd to wherever issues/ lives. If the work isn't planned yet, start with pj-write-prd and pj-plan-issues."
command -v claude >/dev/null 2>&1 || fail "claude is not on PATH"

# --- where the `make test` gate lives ---------------------------------------

# True when DIR holds a Makefile declaring a `test` target.
has_test_target() {
	[ -f "$1/Makefile" ] && grep -q '^test:' "$1/Makefile"
}

if [ -n "$test_dir" ]; then
	[ -d "$test_dir" ] || fail "--test-dir '$test_dir' is not a directory"
	has_test_target "$test_dir" || fail "--test-dir '$test_dir' has no Makefile with a 'test' target -- that target is this loop's only check that the work actually works"
elif has_test_target .; then
	test_dir="."
else
	# Depth-limited, and pruning the directories that are full of vendored
	# Makefiles nobody means, so that on a large monorepo this stays a
	# moment's work and the candidates it reports back are all plausible
	# answers to "which suite gates this run?".
	candidates="$(
		find . -maxdepth 4 \
			\( -name .git -o -name node_modules -o -name venv -o -name .venv \
			   -o -name vendor -o -name target -o -name build -o -name dist \) -prune -o \
			-name Makefile -print 2>/dev/null | sed 's|/Makefile$||' | sort
	)"

	discovered=""
	found=0
	while IFS= read -r candidate; do
		[ -n "$candidate" ] || continue
		has_test_target "$candidate" || continue
		discovered="$discovered${candidate#./}
"
		found=$((found + 1))
	done <<-CANDIDATES
		$candidates
	CANDIDATES

	if [ "$found" -eq 0 ]; then
		fail "no Makefile with a 'test' target under $project_root -- this loop uses 'make test' as its gate, so the project needs one. Pass --test-dir DIR if it lives somewhere this didn't look."
	fi

	if [ "$found" -gt 1 ]; then
		fail "several 'make test' targets under $project_root -- pass --test-dir to say which one gates this run:
$(printf '%s' "$discovered" | sed 's|^|  |')"
	fi

	test_dir="$(printf '%s' "$discovered" | head -1)"
fi

test_dir_abs="$(cd "$test_dir" && pwd)"
test_dir_rel="${test_dir#./}"

# The implementing agent runs at the project root, so when the gate is
# elsewhere it has to be told -- a plain `make test` there would fail, or worse,
# run some other subproject's suite.
test_hint=""
if [ "$test_dir_abs" != "$project_root" ]; then
	say "gating on the 'make test' target in $test_dir_rel"
	test_hint="

The test suite for this work is in $test_dir_rel: run it with 'make -C $test_dir_rel test'. There is no test target at the project root."
fi

export PJ_ISSUES_DIR="$project_root/issues"

"$BIN_DIR/pj-issues" validate >/dev/null || fail "the issue tree doesn't validate -- run 'pj-issues validate' and fix it before starting an unattended run"

if [ -n "$(git status --porcelain)" ]; then
	fail "the working tree is dirty. Each issue has to become exactly one reviewable commit, which isn't possible on top of uncommitted changes -- commit or stash them first."
fi

# --- dry run ---------------------------------------------------------------

if [ -n "$dry_run" ]; then
	say "would drain the following, in this order:"
	"$BIN_DIR/pj-issues" list
	exit 0
fi

# --- run setup -------------------------------------------------------------

run_id="$(date +%Y%m%d-%H%M%S)"
run_dir="issues/runs/$run_id"
mkdir -p "$run_dir"
run_log="$run_dir/run.log"

log() {
	printf '[%s] %s\n' "$(date +%H:%M:%S)" "$1" >> "$run_log"
}

say "run $run_id -- logging to $run_dir"
log "started in $project_root, gating on $test_dir_abs"

# run_claude_sink RENDERER_ARGS... -- where a phase's output goes.
#
# Split out of the pipeline below only so that pipeline has one stage and no
# inline conditional in it. Reads $plain and $logfile from run_claude, which is
# the only caller.
run_claude_sink() {
	if [ -n "$plain" ]; then
		tee -a "$logfile"
	else
		# The raw stream is archived before rendering, so the archive is what
		# claude actually said rather than what this repo understood of it.
		tee -a "${logfile%.log}.jsonl" | python3 -u "$@"
	fi
}

# run_claude PROMPT LOGFILE PHASE
#
# One headless Claude Code invocation, rendered live to the terminal as a
# labeled event stream and archived twice: the rendered lines, without color,
# to LOGFILE, and claude's untouched JSONL beside it as LOGFILE with a .jsonl
# extension. Both, because the rendered log is the one you read and the JSONL
# is the one you re-render or grep when the rendering turns out to have dropped
# the thing you needed. Returns claude's own exit status.
#
# PHASE is the label every line of this invocation carries (tdd, rev, fix).
# claude's default text output would print nothing at all until the phase ends
# and then emit one undifferentiated blob -- which is least acceptable in
# exactly this case, since the reason to watch an unattended run is to see, as
# it happens, that the implementing agent is on the issue you meant and the
# reviewer is a separate process that actually re-read the code.
#
# Getting claude's status still takes the `echo $? > status_file` dance:
# output is piped, and a POSIX pipeline's status is the *last* command's -- so
# a plain `claude ... | tee` would report tee's success no matter how badly
# claude failed. The alternative, buffering to a file and printing it
# afterwards, would cost exactly the live progress this is all for.
#
# Credentials are stripped here rather than once at the top so it stays true
# however the loop was invoked, and with `env -u` rather than `unset` so the
# parent shell keeps its own environment.
run_claude() {
	prompt="$1"
	logfile="$2"
	phase="$3"

	claude_status_file="$(mktemp)"

	# The sink is built with `set --` so the pipeline below has no unquoted
	# expansion in it -- `$@` carries the renderer's arguments, escape
	# sequence and all, as single words under `set -u`.
	if [ -n "$plain" ]; then
		format_args=""
		set --
	else
		format_args="--verbose --output-format stream-json"
		set -- "$DOTFILES_HOME/agents/lib/stream_render.py" \
			--label "$phase" --log "$logfile" --width "$term_width"
		# $C_RESET is the authoritative "color is on" answer: color.sh
		# already weighed $NO_COLOR and both streams being terminals. The
		# renderer sits mid-pipeline, where its own isatty check would say
		# no whatever the terminal is.
		if [ -n "$C_RESET" ]; then
			set -- "$@" --color
		fi
	fi

	{
		# shellcheck disable=SC2086  # deliberate splitting: both are flag lists
		env -u GH_TOKEN -u GITHUB_TOKEN \
			-u AWS_ACCESS_KEY_ID -u AWS_SECRET_ACCESS_KEY -u AWS_SESSION_TOKEN \
			-u AWS_PROFILE -u AWS_REGION -u AWS_DEFAULT_REGION \
			PJ_STOP_TESTS=1 PJ_TEST_DIR="$test_dir_abs" \
			claude -p "$prompt" \
			--dangerously-skip-permissions \
			$format_args \
			${PJ_CLAUDE_ARGS:-} 2>&1
		echo $? > "$claude_status_file"
	} | run_claude_sink "$@"

	# Empty when claude was killed outright (SIGKILL, or the VM going away)
	# before it could write its status -- treat that as a failure rather than
	# letting `return ""` become a shell error the caller can't interpret.
	claude_status="$(cat "$claude_status_file" 2>/dev/null || true)"
	rm -f "$claude_status_file"
	[ -n "$claude_status" ] || claude_status=1

	return "$claude_status"
}

# make_test_gate LOGFILE -> 0 pass, 1 fail
#
# The gate suite, as one line. Until now it printed nothing at all: the run's
# only real check that the work works was the one part of the run you couldn't
# watch. A green gate should cost a glance; a red one has to show why on the
# spot, because the reason the run just stopped is in that output and nobody
# should have to go find a log for it. The full output goes to LOGFILE either
# way, and only the tail is printed -- a suite with a thousand lines of chatter
# would otherwise bury the failure it just reported as thoroughly as silence.
make_test_gate() {
	gate_output="$(mktemp)"

	printf '%s %s%-4s%s %s %s' \
		"$(date +%H:%M:%S)" "$(phase_color gate)" "gate" "$C_RESET" \
		"$GLYPH_STEP" "make test in ${test_dir_rel:-.} ... "

	if make -C "$test_dir_abs" test > "$gate_output" 2>&1; then
		gate_status=0
	else
		gate_status=$?
	fi

	cat "$gate_output" >> "$1"

	if [ "$gate_status" -eq 0 ]; then
		printf '%s\n' "pass"
	else
		printf '%s%s (exit %s)%s\n' "$C_RED" "$GLYPH_BAD" "$gate_status" "$C_RESET"
		tail -n 40 "$gate_output" | sed 's/^/             /'
	fi

	rm -f "$gate_output"
	return "$gate_status"
}

completed=0

while :; do
	if [ -n "$max_issues" ] && [ "$completed" -ge "$max_issues" ]; then
		say "reached --max-issues $max_issues"
		log "stopping: reached --max-issues $max_issues"
		break
	fi

	if ! issue_path="$("$BIN_DIR/pj-issues" next)"; then
		say "queue drained -- nothing left that isn't blocked"
		log "queue drained"
		break
	fi

	issue_name="$(basename "$issue_path")"
	issue_slug="${issue_name%.md}"
	issue_log="$run_dir/$issue_slug.log"

	say_phase tdd "implementing $issue_name"
	log "implementing $issue_name"

	commit_before="$(git rev-parse HEAD)"

	run_claude "Use the pj-tdd skill to implement exactly this one issue: $issue_path

Follow that skill's procedure literally, including the red-green-refactor loop
and its rules about stopping rather than expanding scope.

Do not commit. Leave your work uncommitted in the working tree: it is reviewed
before it is committed, and this loop makes the commit itself once the review
passes. Do not start any other issue. Do not push.$test_hint" "$issue_log" tdd || {
		say_phase tdd "claude exited non-zero while implementing $issue_name -- stopping"
		log "stopped: claude failed on $issue_name"
		break
	}

	# pj-tdd deliberately leaves an issue in issues/ when some acceptance
	# criterion needs a human. Detecting that here is what stops the loop
	# picking the same issue up again forever.
	if [ -f "$issue_path" ]; then
		say_phase tdd "$issue_name is still in issues/ -- pj-tdd left it for a human (see its Notes section)"
		log "stopped: $issue_name not completed, left in issues/"
		break
	fi

	# An implementation that committed anyway is rewound rather than refused:
	# the content is all still there, and collapsing it back into the working
	# tree keeps one path through the rest of the loop -- review, then exactly
	# one commit made here. Refusing instead would strand finished work.
	if [ "$(git rev-parse HEAD)" != "$commit_before" ]; then
		say_phase tdd "$issue_name was committed despite the instruction not to -- rewinding so the review sees it before it lands"
		log "rewound a premature commit for $issue_name"
		git reset --soft "$commit_before" >/dev/null
	fi

	# Staged rather than left loose so that one command -- `git diff --cached`
	# -- shows the reviewer every change including new files, which a plain
	# `git diff` would silently omit.
	git add -A

	if git diff --cached --quiet; then
		say_phase tdd "$issue_name produced no changes -- stopping rather than reviewing and committing nothing"
		log "stopped: no changes produced for $issue_name"
		break
	fi

	if ! make_test_gate "$issue_log"; then
		say_phase gate "make test is failing after $issue_name -- stopping"
		log "stopped: make test failed after $issue_name"
		break
	fi

	# --- review, in a context that didn't write the code -------------------
	#
	# Before the commit, not after it. A review that runs afterwards can only
	# ever ask for an amendment, which means the queue and the history can
	# disagree about whether an issue is done -- and they did: an issue that
	# failed review twice went back to the queue while its commit stayed in
	# the branch, so a later run built a second commit for the same issue.
	# Nothing to back out if nothing was committed.

	verdict_file="issues/reviews/$issue_slug.md"
	attempt=1

	while [ -n "$review" ]; do
		say_phase rev "reviewing $issue_name (attempt $attempt)"
		rm -f "$verdict_file"

		run_claude "Use the pj-review skill to review the implementation of
issues/done/$issue_name. It is not committed: the work under review is the
staged change, which 'git diff --cached' shows in full, including new files.

Write your verdict to $verdict_file. Review only; do not change any code, and
do not commit -- this loop commits once you approve.$test_hint" \
			"$run_dir/$issue_slug.review.log" rev || {
			say_phase rev "claude exited non-zero while reviewing $issue_name -- stopping"
			log "stopped: claude failed reviewing $issue_name"
			exit 1
		}

		if [ ! -f "$verdict_file" ]; then
			say_phase rev "the review produced no verdict file -- stopping"
			log "stopped: no verdict file for $issue_name"
			exit 1
		fi

		verdict="$(head -1 "$verdict_file")"
		log "review verdict for $issue_name: $verdict"

		case "$verdict" in
			"Verdict: approved")
				say_ok rev "approved"
				say_verdict "$verdict_file" reviewed
				break
				;;
			"Verdict: changes-requested")
				say_bad rev "changes requested"
				say_verdict "$verdict_file" findings

				if [ "$attempt" -ge 2 ]; then
					say_phase rev "still changes-requested after a remediation pass -- stopping for a human"
					log "stopped: $issue_name unresolved after remediation"
					# Back out of done/ so the queue reflects reality: this
					# issue is not finished, and a later run must not skip it.
					# The work itself stays staged in the tree, unreviewed and
					# uncommitted, which is exactly what it is -- there is no
					# commit to disown, because none was ever made.
					mkdir -p issues
					mv "issues/done/$issue_name" "issues/$issue_name"
					say_phase rev "the work is left staged and uncommitted in the working tree; $verdict_file says what is wrong"
					exit 1
				fi

				say_phase rev "one remediation pass"
				log "remediating $issue_name"

				run_claude "The review in $verdict_file requested changes to your
implementation of issues/done/$issue_name, which is staged but not committed.
Read the review, address every finding, and keep the test suite green.

Do not commit and do not push: this loop commits once the review passes.$test_hint" \
					"$run_dir/$issue_slug.remediate.log" fix || {
					say_phase fix "claude exited non-zero while remediating $issue_name -- stopping"
					log "stopped: claude failed remediating $issue_name"
					exit 1
				}

				if [ "$(git rev-parse HEAD)" != "$commit_before" ]; then
					say_phase fix "the remediation committed despite the instruction not to -- rewinding"
					log "rewound a premature commit while remediating $issue_name"
					git reset --soft "$commit_before" >/dev/null
				fi

				git add -A

				if ! make_test_gate "$issue_log"; then
					say_phase gate "make test is failing after remediation -- stopping"
					log "stopped: make test failed after remediating $issue_name"
					exit 1
				fi

				attempt=$((attempt + 1))
				;;
			*)
				say_phase rev "unrecognized verdict line '$verdict' in $verdict_file -- stopping"
				log "stopped: unrecognized verdict for $issue_name"
				exit 1
				;;
		esac
	done

	# --- the commit, once nothing objects to it ----------------------------
	#
	# Made here rather than by the implementing agent, because "exactly one
	# commit per issue" is the property that makes an unattended run reviewable
	# one issue at a time, and it should not depend on an agent having followed
	# an instruction. pj-commit still writes the message: a subject saying what
	# changed and a body saying why is worth an agent, and a mechanical
	# "Implement 003-slice" would not survive being read back in a month.
	say_phase git "committing $issue_name"

	run_claude "Use the pj-commit skill to make exactly one commit for the
staged work implementing issues/done/$issue_name. It has already been
implemented, tested and reviewed; your job is the commit and its message.

Do not change any code. Do not push." \
		"$run_dir/$issue_slug.commit.log" git || {
		say_phase git "claude exited non-zero while committing $issue_name -- stopping"
		log "stopped: claude failed committing $issue_name"
		exit 1
	}

	new_commits="$(git rev-list --count "$commit_before"..HEAD)"

	if [ "$new_commits" -eq 0 ]; then
		say_phase git "$issue_name produced no commit -- stopping rather than folding it into the next issue's"
		log "stopped: no commit produced for $issue_name"
		exit 1
	fi

	if [ "$new_commits" -gt 1 ]; then
		say_phase git "$issue_name produced $new_commits commits -- stopping, since one commit per issue is what makes this run reviewable"
		log "stopped: $new_commits commits produced for $issue_name"
		exit 1
	fi

	if [ -n "$(git status --porcelain)" ]; then
		say_phase git "uncommitted changes left over after $issue_name -- stopping"
		log "stopped: dirty tree after $issue_name"
		exit 1
	fi

	completed=$((completed + 1))
	say_ok loop "committed $issue_name as $(git rev-parse --short HEAD)"
	log "committed $issue_name as $(git rev-parse HEAD)"
done

say_ok loop "done -- $completed issue(s) completed this run"
log "finished: $completed issue(s)"

echo
"$BIN_DIR/pj-issues" status
echo
say "review the branch one commit at a time: git log --oneline $(git rev-parse --short HEAD)"
