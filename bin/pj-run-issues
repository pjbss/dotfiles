#!/bin/sh
# pj-run-issues
#
# Drains the ready queue in `issues/`: for each unblocked issue, implement it
# test-first, run the suite, review it through two lenses in fresh contexts,
# and commit it only once both approve. Stops on the first thing that doesn't go cleanly,
# rather than pressing on and burying the failure under later work.
#
# One commit per issue is the point of the whole arrangement -- it's what makes
# an unattended run reviewable afterwards one issue at a time, instead of
# arriving as a single undifferentiated branch.
#
# Nothing is committed before it has been reviewed. The implementing agent is
# told to leave its work in the working tree; this loop stages it, gates it on
# the test command, has it reviewed, and makes the commit itself. Reviewing after
# the commit instead -- which is what this used to do -- meant a review could
# only ask for an amendment, so an issue that failed review twice went back
# onto the queue while its commit stayed in the branch, and the next run built
# a second commit for the same issue. There is nothing to disown if nothing was
# committed.
#
# The commit is made by pj-commit in its own process rather than by the
# implementing agent, so "exactly one commit per issue" doesn't rest on an
# agent having followed an instruction.
#
# Each review runs as a separate `claude -p` process, not a subagent of the
# implementing session. A reviewer that shares context with the author has
# already been told why every decision was right, and reliably agrees. There
# are two lenses, in two processes: pj-review for the spec and correctness,
# then pj-review-quality for how the code reads. Their findings are printed,
# not just their verdicts: a review whose substance lives only in a file
# nobody is watching is indistinguishable from one that never ran.
#
# A `changes-requested` from either lens gets up to two remediation passes,
# each followed by the test gate and both lenses again. Still
# changes-requested after the second, the run stops for a human with the work
# left staged.
#
# Usage: pj-run-issues [--max-issues N] [--test-cmd CMD] [--no-review]
#                      [--dry-run] [--plain] [--force] [--help|-h]
#
#   --max-issues N  Stop after N issues (default: drain the queue).
#   --test-cmd CMD  Command that gates the run, run with `sh -c` from the
#                   project root (default: .pj/test, else discovered, see
#                   below).
#   --no-review     Skip both review lenses, and the whole-stack review of a
#                   stacked run (its per-layer gate still runs). For a first
#                   smoke test only.
#   --dry-run       Print the plan -- which issues, in what order -- and exit
#                   without invoking anything.
#   --plain         Print each agent's final message instead of its live event
#                   stream. The escape hatch, see below.
#   --force         Run outside a sandbox. See below; you almost certainly
#                   don't want this.
#
# Every line of output is labeled with the agent that produced it -- `tdd`
# while pj-tdd implements, `rev` and `qual` while the two reviewers read,
# `fix` during a remediation pass, `gate` for the test command, `git` while
# pj-commit writes the commit, `loop` for the loop's own decisions -- and
# colored to match. Several agents and their subagents write to one terminal
# over a run of hours; an unlabeled stream of that is not
# something anyone can audit afterwards, which defeats the point of watching an
# unattended run at all.
#
# --plain gives up the stream and goes back to printing only each agent's final
# message. It exists for one failure this repo can't control: a claude release
# whose stream-json schema the renderer doesn't understand yet would turn every
# line into an unparsed passthrough.
#
# The project is the directory this is run from, not the enclosing git
# repository's root. In a monorepo those aren't the same thing, and the repo
# root is the wrong answer: it holds neither this project's issues nor its
# tests. `issues/` has to be in that directory.
#
# The gate is a command, always run from the project root. Issues and the PRD
# live at the project root because that's where the paths written inside them
# resolve, while in a monorepo the Makefile belongs to one subproject further
# down -- so the command can reach wherever the suite is, e.g.
# `make -C backend test`, or several suites joined with `&&`. The loop never
# needs to know what a package is. The gate is the first of these that applies:
#
#   1. --test-cmd CMD, which wins over everything
#   2. ./.pj/test, an executable script the project commits at its root
#   3. `make test`, when the project root has a `test` target
#   4. `make -C <dir> test`, when exactly one is found in the tree below
#   5. none of those: refused
#
# .pj/test is what a monorepo commits so it stops needing the flag on every
# run. One that exists but isn't executable is refused, not skipped, and so are
# several candidates for arm 4 -- falling through or guessing would mean an
# unattended run gated on tests that never touch the code it wrote.
#
# A run that would end clean first runs the gate once more, from the same root,
# with PJ_TEST_SCOPE=all in its environment: the full sweep. A gate that
# selects suites by what changed can't see one package's change breaking
# another's suite, and the sweep is what keeps "the run ended clean" meaning
# the whole tree is green. It is an environment variable rather than an
# argument so a gate that ignores it -- a plain `make test`, a hand-written
# .pj/test -- just runs what it always runs. A red sweep exits non-zero and
# leaves the run's commits in place: each was reviewed and green on its own,
# and rewinding them would destroy the one-issue-per-commit history. There is
# no sweep when nothing was completed, or when the run stopped early on an
# issue.
#
# Refuses to run outside a spawned sandbox unless --force. This is an
# unattended agent with --dangerously-skip-permissions: the VM is what makes
# that a reasonable thing to do rather than a reckless one.
#
# Strips GH_TOKEN, GITHUB_TOKEN and every AWS_* variable from the environment
# it hands to its children, even in a VM spawned without --no-creds. An
# autonomous coding run needs to read and write the worktree; it does not need
# to be able to push to arbitrary repositories or reach a cloud account, and a
# credential that isn't in the environment can't be exfiltrated by a prompt
# injection sitting in the repo it was pointed at.
#
# Sets PJ_STOP_TESTS=1, which arms the Stop hook: a session cannot finish while
# the gate is red, and PJ_TEST_CMD and PJ_PROJECT_ROOT so that hook runs the
# same command from the same place this loop does -- the agent's own working
# directory is the project root, which in a monorepo has no Makefile, and the
# hook skips silently when it finds none. The session-start hook reads the same
# PJ_TEST_CMD to tell the agent what its gate is.
#
# Stack mode. When the queue was cut from a plan (its issues carry `## Branch`),
# each issue is built on its own gh stack branch, one layer per issue, in plan
# order, and still gets exactly one commit. Before anything runs, the loop
# refuses if the plan isn't approved or the gh-stack extension isn't
# available. Per issue: a branch the stack already has is checked out (a run
# resumed after a stop carries on where it left off, never duplicating or
# reordering a layer); otherwise the first layer starts the stack with
# `gh stack init --base <trunk>`, which must be checked out, and later ones
# go on top with `gh stack top` and `gh stack add`. Every gh call reads
# /dev/null, and a failing one stops the run. The end-of-run sweep runs on the
# top layer. Publishing the stack stays the human's step.
#
# Once a stacked run has drained its plan's queue and the full sweep passes,
# the whole stack is checked before the run ends: pj-stack-verify runs the gate
# on every layer, then pj-review-stack reviews the whole diff, trunk to top,
# against the PRD, the plan and every per-layer review, in its own process
# under the `stak` label. A failing layer stops the run with exit 1. On
# `changes-requested`, each blocking finding is fixed in the layer that owns
# it, bottom to top: a fix agent (`fix`), the gate, one extra commit by
# pj-commit with a `Review:` trailer (`git`), then `gh stack rebase --upstack
# --no-trunk`. Then pj-stack-verify again and exactly one re-review; still
# `changes-requested` stops the run with every fix committed. There is no
# second fix wave. The stack review is skipped,
# saying why, when the run stopped early or --max-issues left plan issues open;
# under --no-review the per-layer gate still runs and only the review is
# skipped.
#
# A stacked run that ends with an approved stack review finalizes the plan's
# test plan with pj-write-test-plan (label `docs`; it must come out
# `Status: final`, the repository untouched) and prints a handoff instead of
# the usual closing lines: each layer bottom to top with its commit and both
# review verdicts, the stack review, the verify result, the test plan and its
# MT/EC cases, and `gh stack submit` as the next command -- plus, inside a
# sandbox, the `gh stack init <layers>` to recreate the stack's metadata on the
# host. Publishing stays the human's step.
#
# Sets PJ_RUN_ISSUES=1 too, a separate marker meaning "an unattended loop run":
# the guard hook refuses to publish a stack (gh stack submit, push, sync,
# merge, link, unstack) under it, even on the host, because publishing is the
# human's step after reading the layers. PJ_STOP_TESTS isn't reused for this --
# it means "arm the Stop hook", and one variable meaning two things is how one
# of them gets switched off by accident.

set -eu

SOURCE="$0"
while [ -h "$SOURCE" ]; do SOURCE="$(readlink "$SOURCE")"; done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
DOTFILES_HOME="$(cd -P "$BIN_DIR/.." && pwd)"

. "$DOTFILES_HOME/sandbox/lib/color.sh"
. "$DOTFILES_HOME/agents/lib/gate.sh"
. "$DOTFILES_HOME/agents/lib/issues.sh"
. "$DOTFILES_HOME/agents/lib/stack.sh"
. "$DOTFILES_HOME/sandbox/lib/help.sh"

# Declared in one place so a terminal that mangles them is a three-line fix
# rather than a search across the file.
GLYPH_STEP='▸'
GLYPH_OK='✓'
GLYPH_BAD='✗'
GLYPH_SUB='↳'

# Asked once, here, because the renderer runs mid-pipeline where stdout is no
# longer the terminal and `tput cols` would answer for the pipe.
term_width="$(tput cols 2>/dev/null || true)"
[ -n "$term_width" ] || term_width=100

for arg in "$@"; do
	case "$arg" in
		--help | -h)
			sandbox_script_help "$SOURCE"
			exit 0
			;;
	esac
done

# A fatal refusal keeps the program name rather than a phase label: it may
# arrive through pj-sbx-run's ssh hop, where "which command said this" is the
# first thing you need to know.
fail() {
	printf "%spj-run-issues:%s %s\n" "$C_RED" "$C_RESET" "$1" >&2
	exit 1
}

# phase_color LABEL -- the color a phase's lines are printed in.
#
# sandbox/lib/color.sh owns the palette, so that the escape sequence for
# "yellow" is decided in one place for every pj- command. The renderer keeps a
# matching table of its own, since it is a separate process and threading the
# codes through argv would be worse than restating three constants -- if one
# side's shades move, move the other's.
phase_color() {
	case "$1" in
		tdd) printf '%s' "$C_GREEN" ;;
		rev) printf '%s' "$C_MAGENTA" ;;
		qual) printf '%s%s' "$C_BOLD" "$C_MAGENTA" ;;
		stak) printf '%s%s' "$C_BOLD" "$C_CYAN" ;;
		docs) printf '%s%s' "$C_BOLD" "$C_GREEN" ;;
		fix) printf '%s' "$C_YELLOW" ;;
		gate) printf '%s' "$C_BLUE" ;;
		git) printf '%s' "$C_BOLD" ;;
		*) printf '%s' "$C_CYAN" ;;
	esac
}

# emit LABEL GLYPH MESSAGE
#
# One line in the same shape agents/lib/stream_render.py renders, for the
# loop's own events. The shapes match deliberately: the console is one stream
# with several writers, and it reads as a single coherent log only if nothing
# in it is shaped differently from everything else.
emit() {
	printf '%s %s%-4s%s %s %s\n' \
		"$(date +%H:%M:%S)" "$(phase_color "$1")" "$1" "$C_RESET" "$2" "$3"
}

say() {
	emit loop "$GLYPH_STEP" "$1"
}

# say_phase LABEL MESSAGE -- a loop decision that belongs to one agent's turn.
say_phase() {
	emit "$1" "$GLYPH_STEP" "$2"
}

say_ok() {
	emit "$1" "$GLYPH_OK" "$2"
}

say_bad() {
	emit "$1" "$GLYPH_BAD" "$2"
}

# say_sub LABEL MESSAGE -- a line subordinate to the one above it, in the same
# shape the renderer indents a subagent's work.
say_sub() {
	printf '%s %s%-4s%s   %s %s\n' \
		"$(date +%H:%M:%S)" "$(phase_color "$1")" "$1" "$C_RESET" "$GLYPH_SUB" "$2"
}

# say_verdict VERDICT_FILE WANT LABEL
#
# Puts the review's own words on the console. The loop used to read only the
# first line of this file and print "changes requested", leaving the findings --
# the entire substance of the review -- visible nowhere but a file nobody was
# watching. That made an enforced review look like a skipped one, and gave no
# way to judge whether the remediation pass that followed had addressed the
# thing that was actually wrong.
#
# WANT is `reviewed` or `findings`. On a clean verdict only the `## Reviewed`
# line is worth printing: it names the sha and whether the reviewer ran the
# suite itself rather than taking a green claim on trust, which is the one
# thing worth seeing on every issue. Findings are printed in full, because a
# run that stops for a human should already have said why.
say_verdict() {
	[ -f "$1" ] || return 0

	awk -v want="$2" '
		/^## Reviewed/ { section = "reviewed"; next }
		/^## Findings/ { section = "findings"; next }
		/^## / { section = "other"; next }
		section != want { next }
		NF == 0 { next }
		{ print }
	' "$1" | while IFS= read -r line; do
		say_sub "$3" "$line"
	done
}

# run_lens LABEL SKILL VERDICT_FILE LOG
#
# Runs one review lens in its own `claude -p` process, puts its verdict and
# findings on the console under LABEL, and sets $lens_verdict to `approved` or
# `changes-requested`. Stops the run on anything else: a reviewer that crashed,
# wrote no file, or wrote a first line this loop can't parse has not reviewed
# anything, and committing on its silence would be committing unreviewed work.
# Sets a global rather than echoing, because it has to be able to exit.
run_lens() {
	lens_label="$1"
	lens_skill="$2"
	lens_file="$3"

	run_claude "Use the $lens_skill skill to review the implementation of
issues/done/$issue_name. It is not committed: the work under review is the
staged change, which 'git diff --cached' shows in full, including new files.

Write your verdict to $lens_file. Review only; do not change any code, and
do not commit -- this loop commits once both reviews approve." \
		"$4" "$lens_label" || {
		say_phase "$lens_label" "claude exited non-zero during $lens_skill on $issue_name -- stopping"
		log "stopped: claude failed in $lens_skill on $issue_name"
		exit 1
	}

	judge_verdict "$lens_label" "$lens_file" "$lens_skill" "$issue_name"
}

# judge_verdict LABEL VERDICT_FILE SKILL SUBJECT
#
# Reads a review's verdict file, puts its verdict and findings on the console
# under LABEL, and sets $lens_verdict to `approved` or `changes-requested`.
# Stops the run on anything else: a review that wrote no file, or a first line
# this loop can't parse, has not reviewed anything.
judge_verdict() {
	lens_label="$1"
	lens_file="$2"
	lens_skill="$3"
	lens_subject="$4"

	if [ ! -f "$lens_file" ]; then
		say_phase "$lens_label" "$lens_skill produced no verdict file ($lens_file) -- stopping"
		log "stopped: no $lens_file from $lens_skill for $lens_subject"
		exit 1
	fi

	lens_line="$(head -1 "$lens_file")"
	log "$lens_skill verdict for $lens_subject: $lens_line"

	case "$lens_line" in
		"Verdict: approved")
			lens_verdict=approved
			say_ok "$lens_label" "approved"
			say_verdict "$lens_file" reviewed "$lens_label"
			;;
		"Verdict: changes-requested")
			lens_verdict=changes-requested
			say_bad "$lens_label" "changes requested"
			say_verdict "$lens_file" findings "$lens_label"
			;;
		*)
			say_phase "$lens_label" "unrecognized verdict line '$lens_line' in $lens_file -- stopping"
			log "stopped: unrecognized verdict in $lens_file"
			exit 1
			;;
	esac
}

max_issues=""
test_cmd=""
review=1
dry_run=""
plain=""
force=""

while [ $# -gt 0 ]; do
	case "$1" in
		--max-issues)
			[ $# -ge 2 ] || fail "--max-issues needs a number"
			max_issues="$2"; shift 2 ;;
		--test-cmd)
			[ $# -ge 2 ] && [ -n "$2" ] || fail "--test-cmd needs a command, e.g. --test-cmd 'make -C backend test'"
			test_cmd="$2"; shift 2 ;;
		--no-review) review=""; shift ;;
		--dry-run) dry_run=1; shift ;;
		--plain) plain=1; shift ;;
		--force) force=1; shift ;;
		*)
			fail "unknown argument '$1'"
			;;
	esac
done

if [ ! -f "${PJ_SANDBOX_MARKER:-/etc/pj-sandbox}" ] && [ -z "$force" ]; then
	fail "not inside a sandbox. This runs a coding agent unattended with permissions disabled -- the VM is what makes that reasonable. Spawn one with 'pj-sbx-spawn <task> --base <name> --no-creds' and run it there, or pass --force if you genuinely mean to do this on this machine."
fi

# PJ_CLAUDE_ARGS is appended after the flags below, and claude takes the last
# --output-format it is given. Overriding it there wouldn't fail -- it would
# leave the renderer with a format it can't read, and the run would go blind
# for its whole duration while still exiting 0. Refuse it instead: a run that
# won't start is recoverable in a way one that silently stopped reporting is
# not.
case "${PJ_CLAUDE_ARGS:-}" in
	*--output-format*)
		[ -n "$plain" ] || fail "PJ_CLAUDE_ARGS sets --output-format, which this loop needs for its live event stream -- a run with that overridden reports nothing for hours rather than failing. Drop it, or pass --plain to give the stream up deliberately."
		;;
esac

git rev-parse --show-toplevel >/dev/null 2>&1 || fail "must be run from inside a git repository"
project_root="$PWD"

[ -d issues ] || fail "no issues/ directory in $project_root -- this loop takes the directory you run it from as the project, not the repository root, so cd to wherever issues/ lives. If the work isn't planned yet, start with pj-write-prd, pj-write-plan and pj-plan-issues."
command -v claude >/dev/null 2>&1 || fail "claude is not on PATH"

# --- the test gate ----------------------------------------------------------

# Resolved by agents/lib/gate.sh, shared with pj-stack-verify and
# pj-affected-tests: --test-cmd if given, else an executable .pj/test, else
# `make test`, else the one `make -C <dir> test` below the project root.
pj_gate_resolve "$test_cmd" || fail "$pj_gate_error"
test_cmd="$pj_gate_cmd"

# The agents are not told the gate here: each session inherits PJ_TEST_CMD,
# and the session-start hook announces it -- the one mechanism an interactive
# session uses too, so the two cannot drift apart.
if [ "$test_cmd" != "make test" ]; then
	say "gating on '$test_cmd'"
fi

export PJ_ISSUES_DIR="$project_root/issues"

"$BIN_DIR/pj-issues" validate >/dev/null || fail "the issue tree doesn't validate -- run 'pj-issues validate' and fix it before starting an unattended run"

if [ -n "$(git status --porcelain)" ]; then
	fail "the working tree is dirty. Each issue has to become exactly one reviewable commit, which isn't possible on top of uncommitted changes -- commit or stash them first."
fi

# --- stack mode ------------------------------------------------------------
#
# A queue cut from a plan (pj-plan-issues) gives each issue a `## Branch`:
# then each issue is built on its own gh stack branch, one layer per issue,
# in plan order. Checked up front so a run that can't build its stack stops
# before any agent has done any work. pj-issues validate has already made
# sure a stacked queue is one consistent chain of one existing plan.
stack_trunk=""
first_issue="$("$BIN_DIR/pj-issues" next 2>/dev/null || true)"
if [ -n "$first_issue" ] && [ -n "$(pj_issues_branch "$first_issue")" ]; then
	plan_ref="$(pj_issues_plan_ref "$first_issue")"
	plan_file="$(pj_issues_plan_file "$PJ_ISSUES_DIR" "$first_issue")"
	plan_status="$(pj_issues_doc_status "$plan_file")"
	[ "$plan_status" = approved ] ||
		fail "$(basename "$first_issue") is a layer of $plan_ref, which isn't approved (Status: ${plan_status:-none}) -- a stack is built only from a plan you've approved."
	gh stack --version </dev/null >/dev/null 2>&1 ||
		fail "$(basename "$first_issue") is a stack layer, and stack mode needs the gh-stack extension, but 'gh stack' isn't available -- install it with 'gh extension install github/gh-stack'."
	stack_trunk="$(pj_issues_doc_header "$plan_file" Trunk)"
	[ -n "$stack_trunk" ] || fail "$plan_ref has no 'Trunk:' line, so there is no branch to build the stack on."
	# Checked now, not when the stack is done: the run ends by finalizing it.
	[ -n "$(pj_issues_doc_header "$plan_file" "Test plan")" ] ||
		fail "$plan_ref has no 'Test plan:' line, so there is no test plan to finalize when the stack is done."
	say "stack mode: one gh stack branch per layer of $plan_ref, on $stack_trunk"
fi

# --- dry run ---------------------------------------------------------------

if [ -n "$dry_run" ]; then
	say "would drain the following, in this order:"
	"$BIN_DIR/pj-issues" list
	exit 0
fi

# --- run setup -------------------------------------------------------------

run_id="$(date +%Y%m%d-%H%M%S)"
run_dir="issues/runs/$run_id"
mkdir -p "$run_dir"
run_log="$run_dir/run.log"

log() {
	printf '[%s] %s\n' "$(date +%H:%M:%S)" "$1" >> "$run_log"
}

say "run $run_id -- logging to $run_dir"
log "started in $project_root, gating on '$test_cmd'"

# run_claude_sink RENDERER_ARGS... -- where a phase's output goes.
#
# Split out of the pipeline below only so that pipeline has one stage and no
# inline conditional in it. Reads $plain and $logfile from run_claude, which is
# the only caller.
run_claude_sink() {
	if [ -n "$plain" ]; then
		tee -a "$logfile"
	else
		# The raw stream is archived before rendering, so the archive is what
		# claude actually said rather than what this repo understood of it.
		tee -a "${logfile%.log}.jsonl" | python3 -u "$@"
	fi
}

# run_claude PROMPT LOGFILE PHASE
#
# One headless Claude Code invocation, rendered live to the terminal as a
# labeled event stream and archived twice: the rendered lines, without color,
# to LOGFILE, and claude's untouched JSONL beside it as LOGFILE with a .jsonl
# extension. Both, because the rendered log is the one you read and the JSONL
# is the one you re-render or grep when the rendering turns out to have dropped
# the thing you needed. Returns claude's own exit status.
#
# PHASE is the label every line of this invocation carries (tdd, rev, fix).
# claude's default text output would print nothing at all until the phase ends
# and then emit one undifferentiated blob -- which is least acceptable in
# exactly this case, since the reason to watch an unattended run is to see, as
# it happens, that the implementing agent is on the issue you meant and the
# reviewer is a separate process that actually re-read the code.
#
# Getting claude's status still takes the `echo $? > status_file` dance:
# output is piped, and a POSIX pipeline's status is the *last* command's -- so
# a plain `claude ... | tee` would report tee's success no matter how badly
# claude failed. The alternative, buffering to a file and printing it
# afterwards, would cost exactly the live progress this is all for.
#
# Credentials are stripped here rather than once at the top so it stays true
# however the loop was invoked, and with `env -u` rather than `unset` so the
# parent shell keeps its own environment.
run_claude() {
	prompt="$1"
	logfile="$2"
	phase="$3"

	claude_status_file="$(mktemp)"

	# The sink is built with `set --` so the pipeline below has no unquoted
	# expansion in it -- `$@` carries the renderer's arguments, escape
	# sequence and all, as single words under `set -u`.
	if [ -n "$plain" ]; then
		format_args=""
		set --
	else
		format_args="--verbose --output-format stream-json"
		set -- "$DOTFILES_HOME/agents/lib/stream_render.py" \
			--label "$phase" --log "$logfile" --width "$term_width"
		# $C_RESET is the authoritative "color is on" answer: color.sh
		# already weighed $NO_COLOR and both streams being terminals. The
		# renderer sits mid-pipeline, where its own isatty check would say
		# no whatever the terminal is.
		if [ -n "$C_RESET" ]; then
			set -- "$@" --color
		fi
	fi

	{
		# shellcheck disable=SC2086  # deliberate splitting: both are flag lists
		env -u GH_TOKEN -u GITHUB_TOKEN \
			-u AWS_ACCESS_KEY_ID -u AWS_SECRET_ACCESS_KEY -u AWS_SESSION_TOKEN \
			-u AWS_PROFILE -u AWS_REGION -u AWS_DEFAULT_REGION \
			-u PJ_TEST_DIR \
			PJ_STOP_TESTS=1 PJ_RUN_ISSUES=1 PJ_TEST_CMD="$test_cmd" PJ_PROJECT_ROOT="$project_root" \
			claude -p "$prompt" \
			--dangerously-skip-permissions \
			$format_args \
			${PJ_CLAUDE_ARGS:-} 2>&1
		echo $? > "$claude_status_file"
	} | run_claude_sink "$@"

	# Empty when claude was killed outright (SIGKILL, or the VM going away)
	# before it could write its status -- treat that as a failure rather than
	# letting `return ""` become a shell error the caller can't interpret.
	claude_status="$(cat "$claude_status_file" 2>/dev/null || true)"
	rm -f "$claude_status_file"
	[ -n "$claude_status" ] || claude_status=1

	return "$claude_status"
}

# make_test_gate LOGFILE [SCOPE] -> 0 pass, 1 fail
#
# The gate suite, as one line. Until now it printed nothing at all: the run's
# only real check that the work works was the one part of the run you couldn't
# watch. A green gate should cost a glance; a red one has to show why on the
# spot, because the reason the run just stopped is in that output and nobody
# should have to go find a log for it. The full output goes to LOGFILE either
# way, and only the tail is printed -- a suite with a thousand lines of chatter
# would otherwise bury the failure it just reported as thoroughly as silence.
#
# SCOPE is exported as PJ_TEST_SCOPE when given, and removed otherwise -- a
# PJ_TEST_SCOPE=all inherited from whatever launched the loop would otherwise
# turn every per-issue gate into the end-of-run sweep. A scoped gate says so on
# its line, so the sweep can't be mistaken for one more issue's gate.
make_test_gate() {
	gate_output="$(mktemp)"
	gate_scope="${2:-}"
	gate_what="$test_cmd"
	[ -z "$gate_scope" ] || gate_what="full sweep (PJ_TEST_SCOPE=$gate_scope): $test_cmd"

	printf '%s %s%-4s%s %s %s' \
		"$(date +%H:%M:%S)" "$(phase_color gate)" "gate" "$C_RESET" \
		"$GLYPH_STEP" "$gate_what ... "

	if (
		cd "$project_root"
		if [ -n "$gate_scope" ]; then
			export PJ_TEST_SCOPE="$gate_scope"
		else
			unset PJ_TEST_SCOPE
		fi
		sh -c "$test_cmd"
	) > "$gate_output" 2>&1; then
		gate_status=0
	else
		gate_status=$?
	fi

	cat "$gate_output" >> "$1"

	if [ "$gate_status" -eq 0 ]; then
		printf '%s\n' "pass"
	else
		printf '%s%s (exit %s)%s\n' "$C_RED" "$GLYPH_BAD" "$gate_status" "$C_RESET"
		tail -n 40 "$gate_output" | sed 's/^/             /'
	fi

	rm -f "$gate_output"
	return "$gate_status"
}

# run_gh ARGS... -- one gh call, stdin from /dev/null (gh-stack prompts when it
# thinks it can, and an unattended run has nobody to answer). A failure stops
# the run, showing the command and what it printed.
run_gh() {
	if ! gh_output="$(gh "$@" </dev/null 2>&1)"; then
		say_phase git "'gh $*' failed -- stopping"
		printf '%s\n' "$gh_output" | sed 's/^/             /'
		log "stopped: 'gh $*' failed: $gh_output"
		exit 1
	fi
}

# prepare_layer BRANCH -- puts the working tree on BRANCH, the gh stack layer
# the next issue is built on. A branch the stack already has (a resumed run)
# is checked out; otherwise a new stack starts on the plan's trunk, or the
# branch is added on top of the existing one -- the only place gh-stack
# v0.3.0 allows an add.
prepare_layer() {
	layer_branch="$1"

	if stack_json="$(gh stack view --json </dev/null 2>/dev/null)"; then
		if printf '%s' "$stack_json" | pj_stack_layers | grep -qxF "$layer_branch"; then
			say_phase git "resuming on $layer_branch, which the stack already has"
			git checkout -q "$layer_branch" || {
				log "stopped: couldn't check out $layer_branch"
				fail "couldn't check out $layer_branch"
			}
			return 0
		fi
		say_phase git "adding $layer_branch on top of the stack"
		run_gh stack top
		run_gh stack add "$layer_branch"
		return 0
	fi

	current_branch="$(git symbolic-ref --quiet --short HEAD || echo "a detached HEAD")"
	if [ "$current_branch" != "$stack_trunk" ]; then
		log "stopped: a new stack needs $stack_trunk checked out, not $current_branch"
		fail "a stacked run starts on the plan's trunk, '$stack_trunk', or resumes from a branch of its stack, and '$current_branch' is neither -- check out '$stack_trunk' and run again."
	fi
	say_phase git "starting the stack: $layer_branch on $stack_trunk"
	run_gh stack init --base "$stack_trunk" "$layer_branch"
}

# require_one_commit WHAT NOUN -- exactly one new commit since $commit_before,
# and a clean tree after it, or the run stops. One commit per NOUN (an issue,
# a stack-review fix) is what makes an unattended run reviewable afterwards.
require_one_commit() {
	new_commits="$(git rev-list --count "$commit_before"..HEAD)"

	if [ "$new_commits" -eq 0 ]; then
		say_phase git "$1 produced no commit -- stopping rather than folding it into the next $2's"
		log "stopped: no commit produced for $1"
		exit 1
	fi

	if [ "$new_commits" -gt 1 ]; then
		say_phase git "$1 produced $new_commits commits -- stopping, since one commit per $2 is what makes this run reviewable"
		log "stopped: $new_commits commits produced for $1"
		exit 1
	fi

	if [ -n "$(git status --porcelain)" ]; then
		say_phase git "uncommitted changes left over after $1 -- stopping"
		log "stopped: dirty tree after $1"
		exit 1
	fi
}

completed=0
# Set by every break that ends the run on a problem rather than on a drained
# queue or --max-issues, so the sweep below can tell the two apart.
stopped_early=""

while :; do
	if [ -n "$max_issues" ] && [ "$completed" -ge "$max_issues" ]; then
		say "reached --max-issues $max_issues"
		log "stopping: reached --max-issues $max_issues"
		break
	fi

	if ! issue_path="$("$BIN_DIR/pj-issues" next)"; then
		say "queue drained -- nothing left that isn't blocked"
		log "queue drained"
		break
	fi

	issue_name="$(basename "$issue_path")"
	issue_slug="${issue_name%.md}"
	issue_log="$run_dir/$issue_slug.log"

	# A stacked issue is built on its own layer. Issues without a branch
	# take none of this and make no gh calls, exactly as before stack mode.
	issue_branch="$(pj_issues_branch "$issue_path")"
	if [ -n "$issue_branch" ]; then
		[ -n "$stack_trunk" ] || fail "$issue_name is a stack layer, but the run didn't start in stack mode -- run pj-issues validate"
		prepare_layer "$issue_branch"
	fi

	say_phase tdd "implementing $issue_name"
	log "implementing $issue_name"

	# Taken after the layer's branch is in place, so the premature-commit
	# rewind and the one-commit check below are per layer.
	commit_before="$(git rev-parse HEAD)"

	run_claude "Use the pj-tdd skill to implement exactly this one issue: $issue_path

Follow that skill's procedure literally, including the red-green-refactor loop
and its rules about stopping rather than expanding scope.

Do not commit. Leave your work uncommitted in the working tree: it is reviewed
before it is committed, and this loop makes the commit itself once the review
passes. Do not start any other issue. Do not push." "$issue_log" tdd || {
		say_phase tdd "claude exited non-zero while implementing $issue_name -- stopping"
		log "stopped: claude failed on $issue_name"
		stopped_early=1
		break
	}

	# pj-tdd deliberately leaves an issue in issues/ when some acceptance
	# criterion needs a human. Detecting that here is what stops the loop
	# picking the same issue up again forever.
	if [ -f "$issue_path" ]; then
		say_phase tdd "$issue_name is still in issues/ -- pj-tdd left it for a human (see its Notes section)"
		log "stopped: $issue_name not completed, left in issues/"
		stopped_early=1
		break
	fi

	# An implementation that committed anyway is rewound rather than refused:
	# the content is all still there, and collapsing it back into the working
	# tree keeps one path through the rest of the loop -- review, then exactly
	# one commit made here. Refusing instead would strand finished work.
	if [ "$(git rev-parse HEAD)" != "$commit_before" ]; then
		say_phase tdd "$issue_name was committed despite the instruction not to -- rewinding so the review sees it before it lands"
		log "rewound a premature commit for $issue_name"
		git reset --soft "$commit_before" >/dev/null
	fi

	# Staged rather than left loose so that one command -- `git diff --cached`
	# -- shows the reviewer every change including new files, which a plain
	# `git diff` would silently omit.
	git add -A

	if git diff --cached --quiet; then
		say_phase tdd "$issue_name produced no changes -- stopping rather than reviewing and committing nothing"
		log "stopped: no changes produced for $issue_name"
		stopped_early=1
		break
	fi

	if ! make_test_gate "$issue_log"; then
		say_phase gate "'$test_cmd' is failing after $issue_name -- stopping"
		log "stopped: '$test_cmd' failed after $issue_name"
		stopped_early=1
		break
	fi

	# --- review, in a context that didn't write the code -------------------
	#
	# Before the commit, not after it. A review that runs afterwards can only
	# ever ask for an amendment, which means the queue and the history can
	# disagree about whether an issue is done -- and they did: an issue that
	# failed review twice went back to the queue while its commit stayed in
	# the branch, so a later run built a second commit for the same issue.
	# Nothing to back out if nothing was committed.

	# Two lenses, each in its own process: pj-review for the spec and
	# correctness, pj-review-quality for how the code reads. The issue goes
	# through only when both approve. Up to two remediation passes, each
	# followed by the gate and both lenses again: a stricter review needs room
	# to converge, and a second pass fixes what the first one's fix missed --
	# but a third would be the loop arguing with itself, so it stops there.
	verdict_file="issues/reviews/$issue_slug.md"
	quality_file="issues/reviews/$issue_slug.quality.md"
	max_remediations=2
	remediations=0

	while [ -n "$review" ]; do
		say_phase rev "reviewing $issue_name (attempt $((remediations + 1)))"
		rm -f "$verdict_file" "$quality_file"

		run_lens rev pj-review "$verdict_file" "$run_dir/$issue_slug.review.log"
		spec_verdict="$lens_verdict"
		run_lens qual pj-review-quality "$quality_file" "$run_dir/$issue_slug.quality.log"

		if [ "$spec_verdict" = approved ] && [ "$lens_verdict" = approved ]; then
			if [ "$remediations" -gt 0 ]; then
				say_ok rev "both reviews approve after $remediations remediation pass(es)"
			fi
			break
		fi

		if [ "$remediations" -ge "$max_remediations" ]; then
			say_phase rev "still changes-requested after $remediations remediation passes -- stopping for a human"
			log "stopped: $issue_name unresolved after $remediations remediation passes"
			# Back out of done/ so the queue reflects reality: this issue is
			# not finished, and a later run must not skip it. The work itself
			# stays staged in the tree, unreviewed and uncommitted, which is
			# exactly what it is -- there is no commit to disown, because none
			# was ever made.
			mkdir -p issues
			mv "issues/done/$issue_name" "issues/$issue_name"
			say_phase rev "the work is left staged and uncommitted in the working tree; $verdict_file and $quality_file say what is wrong"
			exit 1
		fi

		remediations=$((remediations + 1))
		say_phase fix "remediation pass $remediations of $max_remediations"
		log "remediating $issue_name (pass $remediations)"

		run_claude "The reviews in $verdict_file and $quality_file requested changes to your
implementation of issues/done/$issue_name, which is staged but not committed.
Read both. Fix every [blocking] finding. Fix a [note] only where it is cheap
and clearly right. Leave [pre-existing] findings alone: they aren't this
change's to fix, and changing that code would be unrequested scope, which the
next review blocks on. Keep the test suite green.

Do not commit and do not push: this loop commits once both reviews pass." \
			"$run_dir/$issue_slug.remediate.log" fix || {
			say_phase fix "claude exited non-zero while remediating $issue_name -- stopping"
			log "stopped: claude failed remediating $issue_name"
			exit 1
		}

		if [ "$(git rev-parse HEAD)" != "$commit_before" ]; then
			say_phase fix "the remediation committed despite the instruction not to -- rewinding"
			log "rewound a premature commit while remediating $issue_name"
			git reset --soft "$commit_before" >/dev/null
		fi

		git add -A

		if ! make_test_gate "$issue_log"; then
			say_phase gate "'$test_cmd' is failing after remediation -- stopping"
			log "stopped: '$test_cmd' failed after remediating $issue_name"
			exit 1
		fi
	done

	# --- the commit, once nothing objects to it ----------------------------
	#
	# Made here rather than by the implementing agent, because "exactly one
	# commit per issue" is the property that makes an unattended run reviewable
	# one issue at a time, and it should not depend on an agent having followed
	# an instruction. pj-commit still writes the message: a subject saying what
	# changed and a body saying why is worth an agent, and a mechanical
	# "Implement 003-slice" would not survive being read back in a month.
	say_phase git "committing $issue_name"

	run_claude "Use the pj-commit skill to make exactly one commit for the
staged work implementing issues/done/$issue_name. It has already been
implemented, tested and reviewed; your job is the commit and its message.

Do not change any code. Do not push." \
		"$run_dir/$issue_slug.commit.log" git || {
		say_phase git "claude exited non-zero while committing $issue_name -- stopping"
		log "stopped: claude failed committing $issue_name"
		exit 1
	}

	require_one_commit "$issue_name" issue

	completed=$((completed + 1))
	say_ok loop "committed $issue_name as $(git rev-parse --short HEAD)"
	log "committed $issue_name as $(git rev-parse HEAD)"
done

# --- the full sweep, once every issue is in --------------------------------
#
# The one check covering work several commits contributed to, which is why a
# red one names itself rather than the last issue: that issue passed its own
# gate, and is no more to blame than any other.
if [ "$completed" -gt 0 ] && [ -z "$stopped_early" ]; then
	if ! make_test_gate "$run_log" all; then
		say_phase gate "the full sweep is failing across the whole tree, though every issue passed its own gate -- stopping. The $completed commit(s) this run made are left in place; each was reviewed and green on its own"
		log "stopped: the full sweep failed after $completed issue(s)"
		exit 1
	fi
fi

# --- the whole-stack review, once the stack is built -------------------------
#
# Each layer was reviewed on its own; nothing yet has looked at the stack as
# one change. Only once the plan's queue is fully drained: a stack missing a
# layer isn't the stack the plan describes, so reviewing it would be reviewing
# something nobody will publish. First every layer is re-run through the gate
# (pj-stack-verify) -- each becomes its own pull request -- then pj-review-stack
# reads the whole diff against the PRD, the plan and every per-layer review.
# Findings stop the run with every layer still committed; fixing them comes
# next.

# plan_has_open_issues -- true while any open issue still belongs to the plan.
plan_has_open_issues() {
	for open_issue in $(pj_issues_scan "$PJ_ISSUES_DIR"); do
		[ "$(pj_issues_plan_ref "$open_issue")" = "$plan_ref" ] && return 0
	done
	return 1
}

# verify_stack -- the gate on every layer, each on its own, as pj-stack-verify
# runs it (as the full sweep). Stops the run on a red layer.
verify_stack() {
	say_phase stak "verifying every layer with pj-stack-verify"
	if ! verify_out="$("$BIN_DIR/pj-stack-verify" --test-cmd "$test_cmd" </dev/null 2>&1)"; then
		printf '%s\n' "$verify_out" | while IFS= read -r line; do say_sub stak "$line"; done
		say_phase stak "a layer fails '$test_cmd' on its own -- stopping before the stack review"
		log "stopped: pj-stack-verify failed"
		exit 1
	fi
	printf '%s\n' "$verify_out" | while IFS= read -r line; do say_sub stak "$line"; done
}

# run_stack_review -- one pj-review-stack pass over the whole stack, from the
# top layer; sets $lens_verdict.
run_stack_review() {
	top_branch="$(git symbolic-ref --quiet --short HEAD || git rev-parse --short HEAD)"

	say_phase stak "reviewing the whole stack, $stack_trunk...$top_branch"
	rm -f "$stack_file"
	run_claude "Use the pj-review-stack skill to review the whole stack built from
$plan_ref: every layer from $stack_trunk up to $top_branch, which is checked out.

Write your verdict to $stack_file. Review only: do not change any code, do not
commit, and do not publish the stack." "$run_dir/stack-review.log" stak || {
		say_phase stak "claude exited non-zero during the stack review -- stopping"
		log "stopped: claude failed in pj-review-stack"
		exit 1
	}

	judge_verdict stak "$stack_file" pj-review-stack "the stack"
}

# fix_stack -- one wave of fixes for the stack review's blocking findings, each
# made in the layer that owns it (its `Layer:` line), bottom to top, so a fix
# in a lower layer has flowed up into every layer above before that layer is
# fixed. Each fix is gated, committed as one extra commit on its layer (with a
# `Review:` trailer, pj-commit's one exception), and rebased upstack. Every
# owner is checked before any fixer runs: a finding the loop can't place is a
# question for a human, not a guess.
fix_stack() {
	findings_index="$(pj_stack_blocking_findings "$stack_file")"
	if [ -z "$findings_index" ]; then
		say_phase stak "the stack review requested changes but names no [blocking] finding -- stopping for a human"
		log "stopped: changes-requested with no blocking finding in $stack_file"
		exit 1
	fi

	if ! stack_json="$(gh stack view --json </dev/null 2>&1)"; then
		say_phase git "'gh stack view --json' failed -- stopping"
		printf '%s\n' "$stack_json" | sed 's/^/             /'
		log "stopped: 'gh stack view --json' failed: $stack_json"
		exit 1
	fi
	stack_layers="$(printf '%s' "$stack_json" | pj_stack_layers)" || fail "couldn't parse 'gh stack view --json'"

	# Split on the tab by hand: `IFS=<tab> read` treats a tab as whitespace and
	# would swallow the empty owner of a finding with no Layer: line.
	tab="$(printf '\t')"
	while IFS= read -r finding; do
		finding_owner="${finding%%"$tab"*}"
		finding_label="${finding#*"$tab"}"
		if [ -z "$finding_owner" ]; then
			say_phase stak "the blocking finding '$finding_label' has no 'Layer:' line -- stopping before any fix, since there's no telling which layer owns it"
			log "stopped: blocking finding '$finding_label' has no Layer:"
			exit 1
		fi
		if ! printf '%s\n' "$stack_layers" | grep -qxF "$finding_owner"; then
			say_phase stak "the blocking finding '$finding_label' names '$finding_owner', which isn't a branch of this stack -- stopping before any fix"
			log "stopped: blocking finding '$finding_label' names unknown layer $finding_owner"
			exit 1
		fi
	done <<FINDINGS
$findings_index
FINDINGS

	for layer in $stack_layers; do
		layer_findings="$(pj_stack_layer_findings "$stack_file" "$layer")"
		[ -n "$layer_findings" ] || continue
		layer_slug="$(printf '%s' "$layer" | tr '/' '_')"

		say_phase fix "fixing the stack review's findings in $layer"
		git checkout -q "$layer" || fail "couldn't check out $layer"
		commit_before="$(git rev-parse HEAD)"

		run_claude "The whole-stack review in $stack_file requested changes in stack layer
$layer, which is checked out. Fix these findings, and only these, in this
layer -- a fix here reaches every layer above it once this loop rebases them:

$layer_findings

Keep the test suite green. Do not commit, and do not push or publish anything:
this loop commits the fix itself." "$run_dir/stack-fix-$layer_slug.log" fix || {
			say_phase fix "claude exited non-zero while fixing $layer -- stopping"
			log "stopped: claude failed fixing $layer"
			exit 1
		}

		if [ "$(git rev-parse HEAD)" != "$commit_before" ]; then
			say_phase fix "the fix on $layer was committed despite the instruction not to -- rewinding"
			log "rewound a premature commit while fixing $layer"
			git reset --soft "$commit_before" >/dev/null
		fi

		git add -A

		if ! make_test_gate "$run_log"; then
			say_phase gate "'$test_cmd' is failing after the fix on $layer -- stopping"
			log "stopped: '$test_cmd' failed after fixing $layer"
			exit 1
		fi

		say_phase git "committing the fix on $layer"
		run_claude "Use the pj-commit skill to make exactly one commit for the staged
stack-review fix on layer $layer. It is a stack-review fix, not an issue: end
the message with the trailer 'Review: $stack_file' instead of an Issue:
trailer.

Do not change any code. Do not push." "$run_dir/stack-fix-$layer_slug.commit.log" git || {
			say_phase git "claude exited non-zero while committing the fix on $layer -- stopping"
			log "stopped: claude failed committing the fix on $layer"
			exit 1
		}

		require_one_commit "the fix on $layer" "stack-review fix"
		say_ok loop "committed the fix on $layer as $(git rev-parse --short HEAD)"
		log "committed the fix on $layer as $(git rev-parse HEAD)"

		say_phase git "rebasing the layers above $layer onto the fix"
		run_gh stack rebase --upstack --no-trunk
	done
}

review_stack() {
	plan_base="$(basename "$plan_ref" .md)"
	stack_file="issues/reviews/stack${plan_base#plan}.md"

	run_stack_review
	[ "$lens_verdict" = approved ] && return 0

	fix_stack

	run_gh stack top
	verify_stack
	say_phase stak "re-reviewing the whole stack after the fixes -- once"
	run_stack_review
	if [ "$lens_verdict" != approved ]; then
		say_phase stak "the stack review still requests changes after one round of fixes -- stopping for a human; there is no second fix wave. Every fix stays committed, and $stack_file says what is left. Re-running this loop won't re-enter the stack phase: once fixed, run pj-stack-verify and the pj-review-stack skill yourself"
		log "stopped: the stack re-review still requested changes"
		exit 1
	fi
}

# finalize_test_plan -- once the stack is approved, pj-write-test-plan fills
# the plan's test plan in from what the reviews recorded and the layers'
# commits, in its own process (label `docs`). It has to come out `Status:
# final`, and since the test plan is gitignored working state, the repository
# itself must be untouched by it.
finalize_test_plan() {
	test_plan_ref="$(pj_issues_doc_header "$plan_file" "Test plan")"
	[ -n "$test_plan_ref" ] || fail "$plan_ref has no 'Test plan:' line, so there is no test plan to finalize"
	test_plan_file="$PJ_ISSUES_DIR/${test_plan_ref#issues/}"
	head_before="$(git rev-parse HEAD)"
	tree_before="$(git status --porcelain)"

	say_phase docs "finalizing the test plan, $test_plan_ref"
	run_claude "Use the pj-write-test-plan skill in finalize mode on $test_plan_ref:
the stack built from $plan_ref has been reviewed and approved. Fill it in from
the recorded reviews and the layers' commits, as the skill says.

Change nothing but the test plan, and do not commit." "$run_dir/test-plan.log" docs || {
		say_phase docs "claude exited non-zero while finalizing the test plan -- stopping"
		log "stopped: claude failed finalizing $test_plan_ref"
		exit 1
	}

	test_plan_status="$(pj_issues_doc_status "$test_plan_file" 2>/dev/null || true)"
	if [ "$test_plan_status" != final ]; then
		say_phase docs "$test_plan_ref isn't final after finalizing (Status: ${test_plan_status:-none}) -- stopping"
		log "stopped: $test_plan_ref not final"
		exit 1
	fi
	if [ "$(git rev-parse HEAD)" != "$head_before" ] || [ "$(git status --porcelain)" != "$tree_before" ]; then
		say_phase docs "finalizing the test plan changed the repository, not just the test plan -- stopping"
		log "stopped: finalizing $test_plan_ref changed the repository"
		exit 1
	fi
}

# review_verdict FILE -- a review file's verdict, or `missing`.
review_verdict() {
	if [ -f "$1" ]; then
		sed -n '1s/^Verdict: //p' "$1"
	else
		echo missing
	fi
}

# print_handoff -- the end of a stacked run: what was built and checked, what
# is left for a person to verify, and how to publish. Publishing stays the
# human's step; this only says what to run.
print_handoff() {
	say_ok loop "done -- $completed issue(s) completed this run; the stack is built, reviewed and verified"
	log "finished: $completed issue(s), stack approved"

	handoff_layers="$(gh stack view --json </dev/null 2>/dev/null | pj_stack_layers 2>/dev/null || true)"
	echo
	echo "Layers, bottom to top:"
	layer_number=1
	for layer in $handoff_layers; do
		layer_issue=""
		for done_issue in $(pj_issues_scan_done "$PJ_ISSUES_DIR"); do
			if [ "$(pj_issues_branch "$done_issue")" = "$layer" ]; then
				layer_issue="$done_issue"
			fi
		done
		layer_slug="$(basename "${layer_issue:-unknown.md}" .md)"
		spec_file="issues/reviews/$layer_slug.md"
		quality_file="issues/reviews/$layer_slug.quality.md"
		notes="$(cat "$spec_file" "$quality_file" 2>/dev/null | grep -c '^[0-9]*\. \*\*\[note\]' || true)"
		notes_text=""
		[ "${notes:-0}" -eq 0 ] || notes_text="  ($notes note(s) carried to the stack review)"
		printf '  %s  %s  %s  spec: %s  quality: %s%s\n' "$layer_number" "$layer" \
			"$(git rev-parse --short "$layer")" "$(review_verdict "$spec_file")" \
			"$(review_verdict "$quality_file")" "$notes_text"
		layer_number=$((layer_number + 1))
	done

	test_plan_ids="$(grep -o '^### [ME][TC]-[0-9]*' "$test_plan_file" 2>/dev/null | sed 's/^### //' | tr '\n' ' ' | sed 's/ $//')"
	echo
	echo "Stack review: approved -- $stack_file"
	echo "pj-stack-verify: every layer passes '$test_cmd'"
	echo "Test plan: $test_plan_ref -- work through ${test_plan_ids:-its manual cases} by hand"
	echo
	echo "Then publish, from the host:"
	echo "  gh stack submit    # you choose each pull request's title, description and draft state there"
	if [ -f "${PJ_SANDBOX_MARKER:-/etc/pj-sandbox}" ]; then
		echo
		echo "Only the branches travel back to the host, not gh-stack's own record of"
		echo "the stack. If 'gh stack view' there doesn't show it, recreate it first:"
		echo "  gh stack init $(printf '%s ' $handoff_layers | sed 's/ $//')"
	fi
}

stack_approved=""
if [ -n "$stack_trunk" ]; then
	if [ -n "$stopped_early" ]; then
		say_phase stak "skipping the stack review: the run stopped early"
	elif plan_has_open_issues; then
		say_phase stak "skipping the stack review: $plan_ref still has open issues, so the stack isn't finished"
	else
		verify_stack
		if [ -z "$review" ]; then
			# The gate still ran: --no-review skips model reviews, never a gate.
			say_phase stak "skipping the stack review: --no-review"
		else
			review_stack
			finalize_test_plan
			stack_approved=1
		fi
	fi
fi

if [ -n "$stack_approved" ]; then
	print_handoff
	exit 0
fi

say_ok loop "done -- $completed issue(s) completed this run"
log "finished: $completed issue(s)"

echo
"$BIN_DIR/pj-issues" status
echo
say "review the branch one commit at a time: git log --oneline $(git rev-parse --short HEAD)"

# A run that ends clean reads as a fully verified branch, and it isn't one when
# the plan deliberately set checks aside for a person. The loop can't run them
# -- that's what makes them manual -- so the least it can do is refuse to let
# them be forgotten on the way out.
if [ -f issues/manual-tests.md ]; then
	say "then work through the checks no test can make: issues/manual-tests.md"
fi
