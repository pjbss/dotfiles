#!/bin/sh
# pj-sandbox-spawn
#
# Spawns an isolated per-task sandbox: a new git branch + worktree on the
# host, plus an ephemeral Lima VM (booted from sandbox/lima-template.yaml)
# with that worktree mounted read-write, Claude Code/GitHub CLI/GitHub
# Copilot CLI/AWS credentials mounted read-only, Docker plus the Claude
# Code and GitHub Copilot CLIs provisioned unconditionally, and a VS Code
# Remote-SSH-ready `ssh <task-name>` entry -- plus, if the worktree's
# project defines a devcontainer.json (issue 008), the devcontainer CLI
# installed and that devcontainer built/running via `devcontainer up`
# before this returns.
#
# Also forwards the host's active `gh` auth token into the VM (so gh/
# Copilot CLI don't need a fresh login) and bootstraps this dotfiles repo
# inside the VM so the guest gets the same zsh aliases/functions as the
# host. Claude Code needs one manual one-time step for passwordless auth
# inside sandboxes: run `claude setup-token` on the host, then save the
# resulting token yourself (don't paste it through an agent/chat) to
# `~/.claude/sandbox-oauth-token`, e.g.:
#   claude setup-token
#   echo '<token from above>' > ~/.claude/sandbox-oauth-token
#   chmod 600 ~/.claude/sandbox-oauth-token
# Every sandbox VM picks that file up automatically from then on (it lives
# under the already-mounted ~/.claude). Without it, Claude Code still
# works inside the VM, just via an interactive login the first time.
#
# Usage: pj-sandbox-spawn <task-name>

set -eu

SOURCE="$0"
while [ -h "$SOURCE" ]; do SOURCE="$(readlink "$SOURCE")"; done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
DOTFILES_HOME="$(cd -P "$BIN_DIR/.." && pwd)"

. "$DOTFILES_HOME/sandbox/lib/task.sh"
. "$DOTFILES_HOME/sandbox/lib/ssh_config.sh"
. "$DOTFILES_HOME/sandbox/lib/devcontainer.sh"
. "$DOTFILES_HOME/sandbox/lib/worktree.sh"

task_name="${1:-}"
if [ -z "$task_name" ]; then
	echo "usage: pj-sandbox-spawn <task-name>" >&2
	exit 1
fi

if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
	echo "pj-sandbox-spawn: must be run from inside a git repository" >&2
	exit 1
fi

repo_root="$(git rev-parse --show-toplevel)"
repo_name="$(basename "$repo_root")"

# The same slug is used as the branch name, worktree directory name, and
# Lima instance name -- one canonical identifier per task rather than three
# independently-derived ones.
instance_name="$(sandbox_instance_name "$task_name")"

if limactl list --json 2>/dev/null | grep -qF "\"name\":\"$instance_name\""; then
	echo "pj-sandbox-spawn: a sandbox named '$instance_name' already exists -- pick a different task name or tear it down first" >&2
	exit 1
fi

sandbox_root="${SANDBOX_WORKTREE_ROOT:-$HOME/.sandbox-worktrees}/$repo_name"
worktree_path="$sandbox_root/worktrees/$instance_name"
vm_config="$sandbox_root/lima-configs/$instance_name.yaml"

mkdir -p "$sandbox_root/worktrees" "$sandbox_root/lima-configs"

worktree_action="$(sandbox_resolve_worktree_action "$repo_root" "$worktree_path" "$instance_name")" || {
	echo "pj-sandbox-spawn: '$worktree_path' exists but isn't a registered git worktree of this repo -- pick a different task name or remove it first" >&2
	exit 1
}

case "$worktree_action" in
	resume)
		echo "pj-sandbox-spawn: resuming branch/worktree at '$worktree_path' (left behind by a prior teardown)..."
		;;
	attach)
		echo "pj-sandbox-spawn: branch '$instance_name' already exists -- attaching a new worktree at '$worktree_path'..."
		git -C "$repo_root" worktree add "$worktree_path" "$instance_name"
		;;
	*)
		echo "pj-sandbox-spawn: creating branch '$instance_name' and worktree at '$worktree_path'..."
		git -C "$repo_root" worktree add -b "$instance_name" "$worktree_path"
		;;
esac

ssh_port="$(sandbox_allocate_port)"

sandbox_render_lima_config \
	"$DOTFILES_HOME/sandbox/lima-template.yaml" \
	"$ssh_port" \
	"$worktree_path" \
	"${AWS_PROFILE:-}" \
	"$DOTFILES_HOME" > "$vm_config"

echo "pj-sandbox-spawn: starting Lima VM '$instance_name' (SSH port $ssh_port)..."
limactl start --name "$instance_name" --tty=false "$vm_config"

ssh_include_file="${SANDBOX_SSH_INCLUDE_FILE:-$HOME/.ssh/pj-sandbox-config}"
ssh_config_file="${SANDBOX_SSH_CONFIG_FILE:-$HOME/.ssh/config}"
lima_ssh_config="$(limactl ls --format='{{.SSHConfigFile}}' "$instance_name")"

ssh_block="$(sandbox_ssh_render_host_block "$instance_name" "$lima_ssh_config")"
sandbox_ssh_write_entry "$ssh_include_file" "$instance_name" "$ssh_block"
sandbox_ssh_ensure_include "$ssh_include_file" "$ssh_config_file"

# Forward the host's currently-active `gh` auth token into the VM so `gh`
# and the Copilot CLI (which both accept GH_TOKEN/GITHUB_TOKEN in place of
# their own login) work without a fresh device-flow login inside the VM --
# both otherwise store their real credential in the host's macOS Keychain,
# which the mounted ~/.config/gh and ~/.copilot directories above can't
# carry into a Linux guest. Piped over stdin (never as a `limactl shell`
# argument or written to any file on the host) so the token never appears
# in host `ps` output, shell history, or the per-task Lima config on disk.
if command -v gh >/dev/null 2>&1 && gh_token="$(gh auth token 2>/dev/null)" && [ -n "$gh_token" ]; then
	echo "pj-sandbox-spawn: forwarding the host's active 'gh' auth token into the VM for gh/Copilot CLI..."
	printf 'GH_TOKEN=%s\nGITHUB_TOKEN=%s\n' "$gh_token" "$gh_token" | limactl shell "$instance_name" -- sudo tee -a /etc/environment >/dev/null
else
	echo "pj-sandbox-spawn: host 'gh' isn't authenticated -- gh/Copilot CLI will need a fresh login inside the VM"
fi
unset gh_token

# Bootstrap this dotfiles repo inside the VM (mounted read-only above) so
# the guest gets the same zsh aliases/functions as the host, then wire up
# Claude Code's long-lived auth token if the user has opted in (see the
# pj-sandbox-spawn header/README for the one-time `claude setup-token`
# step -- CLAUDE_CODE_OAUTH_TOKEN can't be forwarded from the host's
# session the way GH_TOKEN is above, since it's meant to be a distinct,
# revocable credential rather than a copy of the host's own live session).
# DOTFILES_SANDBOX_GUEST=1 tells install.sh to skip the sandbox/ module
# (no Lima-inside-Lima) and skip dotfiles-sync-agents (the guest already
# sees the host's synced skills live via the read-only ~/.claude/~/.copilot
# mounts, and a rewrite there would fail against those same mounts anyway).
echo "pj-sandbox-spawn: bootstrapping dotfiles (zsh aliases/functions) inside the VM..."
limactl shell "$instance_name" -- sh -c '
	set -eu
	if [ -f "$HOME/.claude/sandbox-oauth-token" ]; then
		printf "CLAUDE_CODE_OAUTH_TOKEN=%s\n" "$(cat "$HOME/.claude/sandbox-oauth-token")" | sudo tee -a /etc/environment >/dev/null
	fi
	if ! command -v zsh >/dev/null 2>&1; then
		sudo apt-get update
		sudo apt-get install -y zsh
	fi
	DOTFILES_SANDBOX_GUEST=1 "$HOME/dotfiles/install.sh"
	sudo chsh -s "$(command -v zsh)" "$(whoami)"
'

if devcontainer_config="$(sandbox_devcontainer_config_path "$worktree_path")"; then
	echo "pj-sandbox-spawn: devcontainer.json found ($devcontainer_config) -- installing the devcontainer CLI and running 'devcontainer up' inside the VM..."
	limactl shell "$instance_name" -- sh -c '
		set -eux
		if ! command -v node >/dev/null 2>&1; then
			sudo apt-get update
			sudo apt-get install -y nodejs npm
		fi
		if ! command -v devcontainer >/dev/null 2>&1; then
			sudo npm install -g @devcontainers/cli
		fi
		# sudo: the docker-group membership this VM just granted its user
		# (lima-template.yaml) only takes effect for a fresh login session --
		# this one is running over the SSH ControlMaster connection Lima
		# opened during boot, before that group change landed (confirmed
		# against a real spawn: `docker ps` failed with a permission error
		# here despite `getent group docker` already listing the user).
		# Sudo sidesteps the timing race entirely since root already owns
		# the docker socket.
		sudo devcontainer up --workspace-folder /workspace
	'
else
	echo "pj-sandbox-spawn: no devcontainer.json found -- leaving VM bare"
fi

echo "pj-sandbox-spawn: sandbox '$instance_name' is up (worktree: $worktree_path, ssh port: $ssh_port) -- run 'ssh $instance_name' or 'pj-sbx-ssh $task_name' to connect"
