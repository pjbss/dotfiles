#!/bin/sh
# pj-sbx-teardown
#
# Tears down a sandbox's Lima VM: stops and deletes the VM (issue 003) and
# removes its VS Code Remote-SSH entry (issue 005). Deliberately leaves the
# git worktree and branch untouched -- only the render artifact under
# lima-configs/ is removed, so the task disappears from
# `pj-sbx-list` (issue 006) while the worktree/branch persist for
# a future `pj-sbx-spawn` against the same task name.
#
# Usage: pj-sbx-teardown <task-name> [--force] [--help|-h]
#
# Before touching the VM, the spawning repo's real git directory is checked
# against the integrity manifest pj-sbx-spawn recorded before the VM booted
# (sandbox/lib/gitdir_guard.sh). That directory is mounted into the guest
# read-write, so a file planted in its `hooks/` runs on the *host* on the next
# host-side git command. A failed check aborts teardown and leaves everything
# exactly as it was -- nothing is stranded, the same command works again once
# you've looked -- so the evidence is still there to inspect. `--force` tears
# down anyway, for when you've inspected it and want the VM gone.

set -eu

SOURCE="$0"
while [ -h "$SOURCE" ]; do SOURCE="$(readlink "$SOURCE")"; done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
DOTFILES_HOME="$(cd -P "$BIN_DIR/.." && pwd)"

. "$DOTFILES_HOME/sandbox/lib/help.sh"

for arg in "$@"; do
	case "$arg" in
		--help | -h)
			sandbox_script_help "$SOURCE"
			exit 0
			;;
	esac
done

. "$DOTFILES_HOME/sandbox/lib/task.sh"
. "$DOTFILES_HOME/sandbox/lib/ssh_config.sh"
. "$DOTFILES_HOME/sandbox/lib/gitdir_guard.sh"

task_name=""
force=""

for arg in "$@"; do
	case "$arg" in
		--force) force=1 ;;
		*) task_name="$arg" ;;
	esac
done

if [ -z "$task_name" ]; then
	echo "usage: pj-sbx-teardown <task-name> [--force]" >&2
	exit 1
fi

if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
	echo "pj-sbx-teardown: must be run from inside a git repository" >&2
	exit 1
fi

repo_root="$(git rev-parse --show-toplevel)"

# repo_name is the *origin* repo's directory name, not repo_root's own
# basename -- resolved via --git-common-dir rather than --show-toplevel so
# this still finds the right sandbox_root when pj-sbx-teardown is run from
# inside one of the tool's own spawned worktrees (e.g.
# ~/.sandbox-worktrees/fire/worktrees/wtools-781): --show-toplevel there
# returns that worktree's own path, whose basename is the task name
# ("wtools-781"), not the repo name ("fire") -- confirmed directly, where
# it caused a real, already-existing sandbox to be reported as not found.
# --git-common-dir, by contrast, always resolves to the original repo's
# shared .git directory regardless of which worktree it's invoked from
# (see pj-sbx-spawn's repo_gitdir, which relies on the same property).
repo_gitdir="$(cd "$repo_root" && cd "$(git rev-parse --git-common-dir)" && pwd)"
repo_name="$(basename "$(dirname "$repo_gitdir")")"

instance_name="$(sandbox_instance_name "$task_name")"

sandbox_root="${SANDBOX_WORKTREE_ROOT:-$HOME/.sandbox-worktrees}/$repo_name"
vm_config="$sandbox_root/lima-configs/$instance_name.yaml"

if [ ! -e "$vm_config" ]; then
	echo "pj-sbx-teardown: no sandbox named '$instance_name' found" >&2
	exit 1
fi

# Checked before anything is stopped or deleted, so a sandbox that wrote
# somewhere it shouldn't have is still fully intact to inspect. Aborting here
# strands nothing: the VM, the SSH entry and the render artifact are all
# exactly as they were, and re-running works once you're satisfied.
gitdir_manifest="$sandbox_root/lima-configs/$instance_name.gitdir-manifest"

if differences="$(sandbox_gitdir_verify "$repo_gitdir" "$gitdir_manifest")"; then
	echo "pj-sbx-teardown: git directory integrity check passed"
elif [ -n "$force" ]; then
	echo "pj-sbx-teardown: git directory integrity check FAILED -- continuing anyway (--force):" >&2
	printf '%s\n' "$differences" >&2
else
	{
		printf '\npj-sbx-teardown: REFUSING TO TEAR DOWN -- git directory integrity check failed.\n\n'
		printf 'The following changed in %s:\n\n' "$repo_gitdir"
		printf '%s\n\n' "$differences"
		printf 'Nothing a sandbox does legitimately writes these files. A file under\n'
		printf 'hooks/ runs on this host on the next host-side git command, and config\n'
		printf 'can do the same via core.hooksPath, filter.*.clean, or an ext:: remote.\n\n'
		printf 'Nothing has been torn down -- inspect, then re-run with --force:\n'
		printf '  ls -la %s/hooks\n' "$repo_gitdir"
		printf '  git -C %s config --list --show-origin\n' "$repo_root"
		printf '  pj-sbx-teardown %s --force\n\n' "$task_name"
	} >&2
	exit 1
fi

# `limactl list <name>` exits non-zero when Lima has no record of the
# instance at all -- distinct from a real Stopped VM, which it reports
# with exit 0. Guarding on this rather than unconditionally running
# stop/delete matters: an already-gone VM (deleted out-of-band, or left
# behind by a prior teardown that got this far and no further -- see
# below) makes `limactl stop`/`delete` fail outright, which under this
# script's `set -eu` aborted before ever reaching the ssh-entry cleanup or
# `rm -f "$vm_config"` below, permanently stranding the render artifact
# with no way to finish tearing it down (confirmed directly against a real
# sandbox stuck in exactly this state).
if limactl list "$instance_name" >/dev/null 2>&1; then
	echo "pj-sbx-teardown: stopping and deleting Lima VM '$instance_name'..."
	limactl stop "$instance_name"
	limactl delete "$instance_name"
else
	echo "pj-sbx-teardown: no Lima VM named '$instance_name' found -- already gone, skipping VM teardown"
fi

ssh_include_file="${SANDBOX_SSH_INCLUDE_FILE:-$HOME/.ssh/pj-sandbox-config}"
sandbox_ssh_remove_entry "$ssh_include_file" "$instance_name"

rm -f "$vm_config" "$gitdir_manifest"

echo "pj-sbx-teardown: sandbox '$instance_name' torn down -- worktree and branch left untouched"
