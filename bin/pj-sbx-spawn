#!/bin/sh
# pj-sbx-spawn
#
# Spawns an isolated per-task sandbox: a new git branch + worktree on the
# host, plus an ephemeral Lima VM (booted from sandbox/lima-template.yaml)
# with that worktree mounted read-write, Claude Code/GitHub CLI/GitHub
# Copilot CLI/AWS credentials mounted read-only, Docker plus the Claude
# Code and GitHub Copilot CLIs provisioned unconditionally, and a VS Code
# Remote-SSH-ready `ssh <task-name>` entry.
#
# Also forwards the host's active `gh` auth token into the VM (so gh/
# Copilot CLI don't need a fresh login) and bootstraps this dotfiles repo
# inside the VM so the guest gets the same zsh aliases/functions as the
# host. Claude Code needs one manual one-time step for passwordless auth
# inside sandboxes: run `claude setup-token` on the host, then save the
# resulting token yourself (don't paste it through an agent/chat) to
# `~/.claude/sandbox-oauth-token`, e.g.:
#   claude setup-token
#   echo '<token from above>' > ~/.claude/sandbox-oauth-token
#   chmod 600 ~/.claude/sandbox-oauth-token
# Every future spawn picks that file up automatically from then on (read
# from the host here, the same way the gh token below is, since ~/.claude
# itself is deliberately not mounted into the VM -- see lima-template.yaml).
# Without it, Claude Code still works inside the VM, just via an
# interactive login the first time.
#
# Separately, this also seeds the guest's onboarding/bypass-permissions
# disclaimer state directly into ~/.claude.json (see the guest bootstrap
# below): CLAUDE_CODE_OAUTH_TOKEN alone does not skip Claude Code's
# first-run onboarding wizard on a brand-new VM, and even accepting the
# bypass-permissions disclaimer interactively once didn't reliably persist
# (confirmed directly against two spawned sandboxes). With this seeded,
# `claude --bg "<prompt>" --dangerously-skip-permissions` works headlessly
# with zero manual intervention per VM.
#
# All of the above -- the forwarded gh/Claude tokens and making zsh the
# active shell -- are exported/exec'd from the guest's own bash login file
# rather than via `/etc/environment`/`chsh`, since this VM's single SSH
# ControlMaster connection (opened by Lima at boot) makes every later
# session reuse whatever PAM/passwd read at that original connection time,
# no matter how many times you reconnect (confirmed directly; see the
# comment above the relevant block below for the full explanation).
#
# Usage: pj-sbx-spawn <task-name> --base <name> [--ports <comma-separated-list>] [--help|-h]
#
# --base <name> is required and single-valued (no comma-separated/combined
# templates): it selects one of the named provisioning templates under
# sandbox/templates/ (see sandbox/lib/base_template.sh), e.g. `python3.12`,
# `python3.14`, or `none` for today's bare-VM provisioning made an
# explicit, nameable choice. `--base list` prints every valid name (one
# per line) and exits, without requiring a task name or touching any
# branch/worktree/VM.
#
# --ports <comma-separated-list> is optional: each listed guest port (e.g.
# `--ports 8000,5432`) is forwarded to a distinct, dynamically-allocated
# free host port (sandbox_allocate_ports, sandbox/lib/task.sh), never
# reusing a host port already claimed by another running sandbox -- so the
# same project can run in multiple sandboxes at once without their
# forwarded ports colliding. The resulting host<->guest mapping is printed
# once the VM is up. Omitting `--ports` leaves forwarding unchanged
# (SSH-only).

set -eu

SOURCE="$0"
while [ -h "$SOURCE" ]; do SOURCE="$(readlink "$SOURCE")"; done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
DOTFILES_HOME="$(cd -P "$BIN_DIR/.." && pwd)"

. "$DOTFILES_HOME/sandbox/lib/help.sh"

for arg in "$@"; do
	case "$arg" in
		--help | -h)
			sandbox_script_help "$SOURCE"
			exit 0
			;;
	esac
done

. "$DOTFILES_HOME/sandbox/lib/task.sh"
. "$DOTFILES_HOME/sandbox/lib/ssh_config.sh"
. "$DOTFILES_HOME/sandbox/lib/worktree.sh"
. "$DOTFILES_HOME/sandbox/lib/workspace.sh"
. "$DOTFILES_HOME/sandbox/lib/base_template.sh"

templates_dir="$DOTFILES_HOME/sandbox/templates"

task_name=""
base_name=""
ports_arg=""

while [ $# -gt 0 ]; do
	case "$1" in
		--base)
			base_name="${2:-}"
			shift 2
			;;
		--ports)
			ports_arg="${2:-}"
			shift 2
			;;
		*)
			task_name="$1"
			shift
			;;
	esac
done

if [ "$base_name" = "list" ]; then
	sandbox_base_template_list "$templates_dir"
	exit 0
fi

if [ -z "$task_name" ]; then
	echo "usage: pj-sbx-spawn <task-name> --base <name>" >&2
	exit 1
fi

if [ -z "$base_name" ]; then
	echo "pj-sbx-spawn: --base <name> is required -- valid names: $(sandbox_base_template_list "$templates_dir" | tr '\n' ' ')" >&2
	exit 1
fi

if ! base_template_path="$(sandbox_base_template_path "$templates_dir" "$base_name")"; then
	echo "pj-sbx-spawn: unrecognized --base '$base_name' -- valid names: $(sandbox_base_template_list "$templates_dir" | tr '\n' ' ')" >&2
	exit 1
fi

if [ -n "$ports_arg" ]; then
	old_ifs="$IFS"
	IFS=','
	for guest_port in $ports_arg; do
		case "$guest_port" in
			''|*[!0-9]*)
				IFS="$old_ifs"
				echo "pj-sbx-spawn: invalid --ports '$ports_arg' -- must be a comma-separated list of port numbers" >&2
				exit 1
				;;
		esac
	done
	IFS="$old_ifs"
fi

if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
	echo "pj-sbx-spawn: must be run from inside a git repository" >&2
	exit 1
fi

repo_root="$(git rev-parse --show-toplevel)"
repo_name="$(basename "$repo_root")"

# The repo's real (common) git directory -- NOT repo_root itself. A linked
# worktree's `.git` is a file pointing at an absolute host path under this
# directory (`.../worktrees/<name>`), so the VM needs this exact directory
# mounted at the same absolute path for any git command inside the spawned
# worktree to work at all (see sandbox_render_lima_config's doc comment
# and lima-template.yaml for the full explanation). Resolved via `cd` into
# whatever (possibly relative) path `--git-common-dir` reports, rather
# than assuming "$repo_root/.git" directly, so this also works correctly
# if repo_root is itself already a linked worktree of some other repo.
repo_gitdir="$(cd "$repo_root" && cd "$(git rev-parse --git-common-dir)" && pwd)"

# The same slug is used as the branch name, worktree directory name, and
# Lima instance name -- one canonical identifier per task rather than three
# independently-derived ones.
instance_name="$(sandbox_instance_name "$task_name")"

if limactl list --json 2>/dev/null | grep -qF "\"name\":\"$instance_name\""; then
	echo "pj-sbx-spawn: a sandbox named '$instance_name' already exists -- pick a different task name or tear it down first" >&2
	exit 1
fi

sandbox_root="${SANDBOX_WORKTREE_ROOT:-$HOME/.sandbox-worktrees}/$repo_name"
worktree_path="$sandbox_root/worktrees/$instance_name"
vm_config="$sandbox_root/lima-configs/$instance_name.yaml"

mkdir -p "$sandbox_root/worktrees" "$sandbox_root/lima-configs"

worktree_action="$(sandbox_resolve_worktree_action "$repo_root" "$worktree_path" "$instance_name")" || {
	echo "pj-sbx-spawn: '$worktree_path' exists but isn't a registered git worktree of this repo -- pick a different task name or remove it first" >&2
	exit 1
}

case "$worktree_action" in
	resume)
		echo "pj-sbx-spawn: resuming branch/worktree at '$worktree_path' (left behind by a prior teardown)..."
		;;
	attach)
		echo "pj-sbx-spawn: branch '$instance_name' already exists -- attaching a new worktree at '$worktree_path'..."
		git -C "$repo_root" worktree add "$worktree_path" "$instance_name"
		;;
	*)
		echo "pj-sbx-spawn: creating branch '$instance_name' and worktree at '$worktree_path'..."
		git -C "$repo_root" worktree add -b "$instance_name" "$worktree_path"
		;;
esac

# If the source repo has a <repo_name>.code-workspace file at its root,
# copy it into the new worktree (overwriting any copy `git worktree add`
# already placed there if it happened to be tracked) so VS Code can be
# opened against the sandboxed worktree directly. No-op, no output, if
# the source repo has no such file.
workspace_path=""
if workspace_source="$(sandbox_workspace_source_path "$repo_root")"; then
	workspace_path="$(sandbox_workspace_write "$workspace_source" "$repo_root" "$worktree_path")"
fi

ssh_port="$(sandbox_allocate_port)"

port_mappings=""
if [ -n "$ports_arg" ]; then
	port_mappings="$(sandbox_allocate_ports "$ports_arg")"
fi

sandbox_render_lima_config \
	"$DOTFILES_HOME/sandbox/lima-template.yaml" \
	"$ssh_port" \
	"$worktree_path" \
	"${AWS_PROFILE:-}" \
	"$DOTFILES_HOME" \
	"$repo_gitdir" \
	"$base_template_path" \
	"$port_mappings" > "$vm_config"

echo "pj-sbx-spawn: starting Lima VM '$instance_name' (SSH port $ssh_port)..."
limactl start --name "$instance_name" --tty=false "$vm_config"

if [ -n "$port_mappings" ]; then
	echo "$port_mappings" | while IFS=':' read -r guest_port host_port; do
		[ -z "$guest_port" ] && continue
		echo "pj-sbx-spawn: forwarding localhost:$host_port -> $guest_port"
	done
fi

ssh_include_file="${SANDBOX_SSH_INCLUDE_FILE:-$HOME/.ssh/pj-sandbox-config}"
ssh_config_file="${SANDBOX_SSH_CONFIG_FILE:-$HOME/.ssh/config}"
lima_ssh_config="$(limactl ls --format='{{.SSHConfigFile}}' "$instance_name")"

ssh_block="$(sandbox_ssh_render_host_block "$instance_name" "$lima_ssh_config")"
sandbox_ssh_write_entry "$ssh_include_file" "$instance_name" "$ssh_block"
sandbox_ssh_ensure_include "$ssh_include_file" "$ssh_config_file"

# Capture the host's currently-active `gh` auth token, to forward into the
# VM below so `gh` and the Copilot CLI (which both accept GH_TOKEN/
# GITHUB_TOKEN in place of their own login) work without a fresh
# device-flow login inside the VM -- both otherwise store their real
# credential in the host's macOS Keychain, which the mounted ~/.config/gh
# and ~/.copilot directories above can't carry into a Linux guest. Held in
# a host shell variable only (never written to a file on the host) and
# piped into the VM over stdin below, so it never appears in host `ps`
# output, shell history, or the per-task Lima config on disk.
gh_token=""
if command -v gh >/dev/null 2>&1 && gh_token="$(gh auth token 2>/dev/null)" && [ -n "$gh_token" ]; then
	echo "pj-sbx-spawn: forwarding the host's active 'gh' auth token into the VM for gh/Copilot CLI..."
else
	echo "pj-sbx-spawn: host 'gh' isn't authenticated -- gh/Copilot CLI will need a fresh login inside the VM"
fi

# Same idea for Claude Code's long-lived sandbox token (see the header
# comment above for the one-time `claude setup-token` step): read here on
# the host, held only in this shell variable, and forwarded alongside the
# gh token below -- ~/.claude is deliberately not mounted into the VM (see
# lima-template.yaml), so the guest can no longer read this file itself.
claude_token=""
if [ -f "$HOME/.claude/sandbox-oauth-token" ]; then
	claude_token="$(cat "$HOME/.claude/sandbox-oauth-token")"
	echo "pj-sbx-spawn: forwarding the host's Claude Code sandbox token into the VM..."
else
	echo "pj-sbx-spawn: no ~/.claude/sandbox-oauth-token on the host -- Claude Code will need an interactive login inside the VM"
fi

# Bootstrap this dotfiles repo inside the VM (mounted read-only above) so
# the guest gets the same zsh aliases/functions as the host, wire up
# forwarded auth (the gh token captured above, plus Claude Code's
# long-lived token if the user has opted in -- see the pj-sbx-spawn
# header/README for the one-time `claude setup-token` step), and make zsh
# the shell every session actually lands in.
#
# All three of those (env vars, login shell) are account/session-level
# things that would normally be set via `/etc/environment` (PAM) and
# `chsh`. Neither actually reaches a real session on this VM: every ssh/
# limactl-shell connection, including ones from a brand-new terminal, is
# multiplexed over the single SSH ControlMaster connection Lima opens
# during boot, long before this script ever runs -- and whatever PAM/
# passwd read at that original connection time is what every later session
# over it keeps getting, for the VMs entire life (confirmed directly). So
# instead of fighting that stale connection, this writes the exports and
# a bash-to-zsh handoff directly
# into the guest's own bash login file, which bash re-reads fresh on every
# single login regardless of what the original connection cached.
#
# DOTFILES_SANDBOX_GUEST=1 tells install.sh to skip the sandbox/ module (no
# Lima-inside-Lima); dotfiles-sync-agents still runs normally here, since
# ~/.claude/~/.copilot are ordinary writable directories in the guest, not
# read-only mounts -- it renders this repo's skills/subagents straight
# from the read-only ~/dotfiles mount, same as it would on the host.
#
# Runs over plain `ssh` (the Host entry just written above), not
# `limactl shell` -- confirmed directly that `limactl shell instance --
# sh -c '...'` does not reliably forward piped stdin to the wrapped
# command (it appears to swallow it as if typed at an interactive prompt
# instead), where plain ssh does not have that problem. The gh and Claude
# tokens travel as positional arguments (`sh -s -- "$gh_token"
# "$claude_token"`, so they are available inside the script as $1/$2)
# rather than over stdin, since stdin here is the script's own source
# (`sh -s` reads its script from stdin) -- mixing a script's source and a
# `read` command's input on the same stream is unreliable (confirmed
# directly: a shell reading a piped script does not necessarily do so
# strictly line-by-line, so an embedded `read` can end up consuming bytes
# the interpreter itself still needed).
echo "pj-sbx-spawn: bootstrapping dotfiles and forwarded auth inside the VM..."
ssh "$instance_name" sh -s -- "$gh_token" "$claude_token" <<-'PJSANDBOX_GUEST_BOOTSTRAP'
	set -eu
	gh_token_in="${1:-}"
	claude_token_in="${2:-}"

	if ! command -v zsh >/dev/null 2>&1; then
		sudo apt-get update
		sudo apt-get install -y zsh
	fi
	DOTFILES_SANDBOX_GUEST=1 "$HOME/dotfiles/install.sh"
	sudo chsh -s "$(command -v zsh)" "$(whoami)"

	# Registers Atlassian's official remote MCP server (Jira/Confluence) so
	# Claude Code inside the VM can see it -- but only registers it, doesn't
	# authenticate it. The claude.ai account-level Atlassian connector (what
	# an interactively-logged-in `claude` session sees automatically) is
	# documented to never load when CLAUDE_CODE_OAUTH_TOKEN is the active
	# credential ("can only make model requests" -- code.claude.com/docs/en/
	# authentication), so that connector can't be forwarded the way the
	# oauth token above is. Its OAuth token also isn't a portable string like
	# CLAUDE_CODE_OAUTH_TOKEN -- it lands in a local credentials file/keychain
	# entry -- so unlike the tokens above, this needs a one-time interactive
	# login per spawned VM: run `claude mcp login atlassian --no-browser`
	# over `ssh -t <task-name>`, open the printed URL on this Mac, and paste
	# the resulting redirect URL back at the VM's prompt. `--scope user`
	# keeps this registration available across every project/worktree the
	# guest user touches, rather than just the current one.
	if command -v claude >/dev/null 2>&1 && ! claude mcp list 2>/dev/null | grep -q '^atlassian'; then
		claude mcp add --transport http atlassian https://mcp.atlassian.com/v1/mcp/authv2 --scope user
	fi

	bash_login_file="$HOME/.profile"
	[ -f "$HOME/.bash_login" ] && bash_login_file="$HOME/.bash_login"
	[ -f "$HOME/.bash_profile" ] && bash_login_file="$HOME/.bash_profile"

	if ! grep -qF "pj-sbx-spawn: forwarded host auth" "$bash_login_file" 2>/dev/null; then
		printf '\n# pj-sbx-spawn: forwarded host auth -- exported here rather than via\n# /etc/environment, since that never reaches a real session on this VM.\n' >> "$bash_login_file"
		if [ -n "$gh_token_in" ]; then
			printf 'export GH_TOKEN="%s"\nexport GITHUB_TOKEN="%s"\n' "$gh_token_in" "$gh_token_in" >> "$bash_login_file"
		fi
		if [ -n "$claude_token_in" ]; then
			printf 'export CLAUDE_CODE_OAUTH_TOKEN="%s"\n' "$claude_token_in" >> "$bash_login_file"
		fi
	fi

	# Seed onboarding/disclaimer state directly into Claude Code's own
	# config so `claude --bg ... --dangerously-skip-permissions` works
	# headlessly with zero manual intervention on a fresh VM. Without this,
	# CLAUDE_CODE_OAUTH_TOKEN alone does not skip the first-run onboarding
	# wizard on a brand-new VM -- launching interactively goes theme picker
	# -> "Select login method" -> a dead-end browser OAuth prompt
	# headlessly, never even reaching the actual bypass-permissions
	# disclaimer. Separately, even reaching and accepting that disclaimer
	# interactively once didn't reliably persist to ~/.claude.json on a
	# later launch (confirmed directly against two spawned sandboxes).
	# `bypassPermissionsModeAccepted` is the exact field name `claude --bg`'s
	# disclaimer check reads (found via `strings` on the installed binary
	# near its "requires accepting the disclaimer" error text) --
	# `hasCompletedOnboarding` additionally skips the wizard outright.
	# Setting both directly makes headless dispatch work immediately, no
	# interactive step needed at all.
	claude_version="$(claude --version 2>/dev/null | awk '{print $1}')"
	python3 -c '
import json, os, sys
path = os.path.expanduser("~/.claude.json")
d = json.load(open(path)) if os.path.exists(path) else {}
d.update(hasCompletedOnboarding=True, lastOnboardingVersion=sys.argv[1], bypassPermissionsModeAccepted=True)
json.dump(d, open(path, "w"), indent=2)
' "$claude_version"

	# Guarded by PJSANDBOX_ZSH_HANDED_OFF (exported right before the exec, so
	# every descendant process inherits it) rather than just `-z
	# "$ZSH_VERSION"` -- Claude Code's own Bash tool sources this same
	# profile to initialize each shell it spawns inside the VM (confirmed:
	# its tool description says exactly this), and without the marker, every
	# one of those child bash processes would re-trigger `exec zsh -l` and
	# hang waiting on a real terminal it doesn't have (confirmed directly:
	# this is what "Bash is stalling" inside a spawned VM turned out to be).
	# The marker makes the handoff fire exactly once, for the genuine
	# top-level interactive SSH login -- every child process of that login
	# (including `claude` and everything its Bash tool spawns) inherits the
	# marker and skips the exec, running as plain bash instead.
	if command -v zsh >/dev/null 2>&1 && ! grep -qF "pj-sbx-spawn: hand off to zsh" "$bash_login_file" 2>/dev/null; then
		printf '\n# pj-sbx-spawn: hand off to zsh explicitly here, since chsh alone\n# never applies to this stale-ControlMaster VM session. Guarded by an\n# inherited marker, not just $ZSH_VERSION, so tools that source this same\n# profile to init a child shell (e.g. Claude Code'"'"'s own Bash tool) don'"'"'t\n# get hijacked into a terminal-less interactive zsh and hang.\nif [ -z "$ZSH_VERSION" ] && [ -z "$PJSANDBOX_ZSH_HANDED_OFF" ] && command -v zsh >/dev/null 2>&1; then\n\texport PJSANDBOX_ZSH_HANDED_OFF=1\n\texec zsh -l\nfi\n' >> "$bash_login_file"
	fi
	PJSANDBOX_GUEST_BOOTSTRAP
unset gh_token claude_token

echo "pj-sbx-spawn: sandbox '$instance_name' is up (worktree: $worktree_path, ssh port: $ssh_port) -- run 'ssh $instance_name' or 'pj-sbx-ssh $task_name' to connect"
if [ -n "$workspace_path" ]; then
	echo "pj-sbx-spawn: VS Code workspace file written to $workspace_path"
fi
echo "pj-sbx-spawn: to read Jira/Confluence tickets from inside the VM, run 'ssh -t $instance_name claude mcp login atlassian --no-browser', open the printed URL here, and paste the redirect URL back at the prompt (one-time per VM spawn -- this auth can't be forwarded like the gh/Claude tokens)"
