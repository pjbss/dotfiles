#!/bin/sh
# pj-affected-tests
#
# Runs every package suite that covers what changed in the working tree. A
# monorepo adopts it as its gate by committing `exec pj-affected-tests` as its
# .pj/test, so neither pj-run-issues nor the Stop hook ever has to learn what a
# package is.
#
# Usage: pj-affected-tests [--since REF] [--help|-h]
#
#   --since REF  Select suites from `git diff --name-only REF...HEAD` instead
#                of the working tree -- "what does everything on this branch
#                affect?"
#
# The changed set is `git status --porcelain`, which reports staged, unstaged
# and untracked paths alike, so the same rule holds inside the loop (which
# stages everything before gating) and in a Stop hook firing over loose work.
# Each changed path selects the nearest directory above it, up to the
# repository root, whose Makefile has a `test:` target; each suite selected
# runs once, as `make -C <dir> test`, in sorted order so two runs over the same
# change read the same. Every suite runs even after one fails, and every
# failure is reported.
#
# When nothing maps to a suite, the repository root's own suite runs if it has
# one; otherwise this says on stdout that no suite covers the change and exits
# 0. A gate that passes by finding nothing to do is the failure this command
# exists to prevent, so finding nothing is never silent.
#
# PJ_TEST_SCOPE=all in the environment runs every suite discoverable below the
# root, ignoring what changed -- the end-of-run sweep.
#
# Vendored directories (.git, node_modules, venv, .venv, vendor, target, build,
# dist) are never searched for suites, the same list pj-run-issues prunes.

set -eu

SOURCE="$0"
while [ -h "$SOURCE" ]; do SOURCE="$(readlink "$SOURCE")"; done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
DOTFILES_HOME="$(cd -P "$BIN_DIR/.." && pwd)"

. "$DOTFILES_HOME/sandbox/lib/color.sh"
. "$DOTFILES_HOME/sandbox/lib/help.sh"

fail() {
	printf "%spj-affected-tests:%s %s\n" "$C_RED" "$C_RESET" "$1" >&2
	exit 1
}

since=""
while [ $# -gt 0 ]; do
	case "$1" in
		--help | -h)
			sandbox_script_help "$SOURCE"
			exit 0
			;;
		--since)
			[ $# -ge 2 ] && [ -n "$2" ] || fail "--since needs a REF, e.g. --since origin/main"
			since="$2"
			shift 2
			;;
		*)
			fail "unknown argument '$1' -- see 'pj-affected-tests --help'"
			;;
	esac
done

root="$(git rev-parse --show-toplevel 2>/dev/null)" || fail "must be run from inside a git repository"
cd "$root"

# True when DIR holds a Makefile declaring a `test` target.
has_test_target() {
	[ -f "$1/Makefile" ] && grep -q '^test:' "$1/Makefile"
}

# The directories that are full of vendored Makefiles nobody means -- the same
# list pj-run-issues prunes when it discovers a gate. Neither discovery here
# looks inside them, so a repo full of dependencies doesn't turn the gate into
# a crawl or into running someone else's suite.
PRUNED=".git node_modules venv .venv vendor target build dist"

# True when any component of DIR is one of $PRUNED.
is_pruned() {
	for name in $PRUNED; do
		case "/$1/" in
			*/"$name"/*) return 0 ;;
		esac
	done
	return 1
}

# suite_for PATH -- the nearest directory at or above PATH's own, up to the
# repository root, that has a suite; prints nothing when none does.
suite_for() {
	dir="$(dirname "$1")"
	while :; do
		if ! is_pruned "$dir" && has_test_target "$dir"; then
			printf '%s\n' "$dir"
			return
		fi
		[ "$dir" = "." ] && return
		dir="$(dirname "$dir")"
	done
}

# every_suite -- every suite below the root, pruned directories aside.
every_suite() {
	set --
	for name in $PRUNED; do
		set -- "$@" -o -name "$name"
	done
	shift # the leading -o

	find . \( "$@" \) -prune -o -name Makefile -print 2>/dev/null | sed 's|/Makefile$||; s|^\./||' |
		while IFS= read -r dir; do
			has_test_target "$dir" && printf '%s\n' "$dir"
		done
}

if [ "${PJ_TEST_SCOPE:-}" = "all" ]; then
	suites="$(every_suite | sort)"
else
	if [ -n "$since" ]; then
		# Checked first, because a mistyped REF would otherwise read as a
		# change touching nothing -- and pass.
		git rev-parse --verify --quiet "$since^{commit}" >/dev/null || fail "--since: '$since' is not a commit in this repository"
		changed="$(git diff --name-only "$since...HEAD")"
	else
		# -z is what keeps paths unquoted (so one with a space in it is still
		# that path), and there a rename or copy is its entry's path followed
		# by a bare entry holding the path it came from -- both sides changed.
		# -uall lists the files inside a new untracked directory rather than
		# the directory, which matters when that directory is a whole new
		# package.
		changed="$(
			git status --porcelain -z -uall | tr '\0' '\n' | awk '
				from { print; from = 0; next }
				{ print substr($0, 4); if (substr($0, 1, 2) ~ /[RC]/) from = 1 }
			'
		)"
	fi

	suites="$(
		printf '%s\n' "$changed" | while IFS= read -r path; do
			[ -n "$path" ] && suite_for "$path"
		done | sort -u
	)"
fi

if [ -z "$suites" ]; then
	if has_test_target .; then
		suites="."
	else
		echo "pj-affected-tests: no suite covers the change -- nothing to run under $root"
		exit 0
	fi
fi

# Every suite runs even after one fails: stopping at the first red would only
# make an agent re-run the gate to find the next one, and the run stops either
# way. Each suite's stdin is /dev/null, since the loop's own stdin is the list
# of suites still to run.
total=0
failed=""
while IFS= read -r suite; do
	[ -n "$suite" ] || continue
	total=$((total + 1))
	printf '\n%s=== %s ===%s\n' "$C_BOLD" "$suite" "$C_RESET"
	make -C "$suite" test </dev/null || failed="$failed$suite
"
done <<-SUITES
	$suites
SUITES

printf '\n%s=== summary ===%s\n' "$C_BOLD" "$C_RESET"
if [ -z "$failed" ]; then
	echo "$total suite(s), all passed"
	exit 0
fi
echo "$total suite(s), $(printf '%s' "$failed" | grep -c .) failed"
printf '%s' "$failed" | while IFS= read -r suite; do
	printf '  %sFAILED:%s %s\n' "$C_RED" "$C_RESET" "$suite"
done
exit 1
