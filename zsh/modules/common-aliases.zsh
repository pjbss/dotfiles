#!/bin/sh
# ported from oh-my-zsh common-aliases plugin; audited against ~/.zsh_history,
# only the aliases actually used were kept
alias l='ls -lFh'     #size,show type,human readable
alias la='ls -lAFh'   #long list,show almost all,show type,human readable
alias grep='grep --color'
alias rm='rm -i'
alias mv='mv -i'
