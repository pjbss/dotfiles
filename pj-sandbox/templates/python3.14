- mode: system
  script: |
    #!/bin/sh
    set -eux
    if ! command -v python3.14 >/dev/null 2>&1; then
      apt-get update
      apt-get install -y software-properties-common
      add-apt-repository -y ppa:deadsnakes/ppa
      apt-get update
      apt-get install -y python3.14 python3.14-venv python3.14-dev
    fi
