#!/bin/sh
# pj-sandbox
#
# The single entry point for the next-generation sandbox. Each subcommand
# lives in its own lib/cmd_<sub>.sh, which defines a cmd_<sub> function; this
# file only resolves which one to load. Until promotion it's run by path
# (pj-sandbox/bin/pj-sandbox), never put on PATH -- see pj-sandbox/README.md.
#
# Usage: pj-sandbox <subcommand> [args...]
#
# Subcommands:
#   spawn    Create and boot a sandbox VM for a task
#   exec     Run a command inside a sandbox
#   run      Run an agent unattended inside a sandbox
#   attach   Open an interactive shell in a sandbox
#   list     List sandboxes
#   status   Show one sandbox's state
#   logs     Show a sandbox's egress log
#   allowlist  Suggest allowlist entries from a sandbox's egress log
#   fetch    Fetch a sandbox's branches into refs/sandbox/<task>/*
#   verify   Check a sandbox's security properties
#   rm       Tear down a sandbox
#   gc       Clean up state left by sandboxes that no longer exist
#   help     Show this help

set -eu

SOURCE="$0"
while [ -h "$SOURCE" ]; do
	link="$(readlink "$SOURCE")"
	case "$link" in
		/*) SOURCE="$link" ;;
		*) SOURCE="$(dirname "$SOURCE")/$link" ;;
	esac
done
PJ_SANDBOX_HOME="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
# For lib/namespace.sh, which can't find its own path.
PJ_SANDBOX_DOTFILES_HOME="${PJ_SANDBOX_DOTFILES_HOME:-$(dirname "$PJ_SANDBOX_HOME")}"

usage() {
	sed -n '2,/^$/p' "$SOURCE" | sed 's/^# \{0,1\}//'
}

if [ "$#" -eq 0 ]; then
	usage >&2
	exit 1
fi

sub="$1"
shift

case "$sub" in
	--help | -h | help)
		usage
		exit 0
		;;
	spawn | exec | run | attach | list | status | logs | allowlist | fetch | verify | rm | gc) ;;
	*)
		echo "pj-sandbox: unknown subcommand '$sub' (see 'pj-sandbox --help')" >&2
		exit 1
		;;
esac

cmd_file="$PJ_SANDBOX_HOME/lib/cmd_$sub.sh"
if [ ! -f "$cmd_file" ]; then
	echo "pj-sandbox: $sub: not implemented yet" >&2
	exit 2
fi

# shellcheck source=/dev/null
. "$cmd_file"
"cmd_$sub" "$@"
